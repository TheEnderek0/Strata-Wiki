92,"meta":93},"p2ce-mod-template",{"title":94,"type":51},"P2:CE Mod Template",{"id":96,"meta":97},"vtf-v76",{"title":98,"type":51},"VTF v7.6 Format",[],{"id":101,"title":102,"weight":103,"type":51,"articles":104,"subtopics":132},"modding/util","Utilities",50,[105,108,111,114,117,120,123,126,129],{"id":106,"meta":107},"dmxconvert",{"title":106,"type":51},{"id":109,"meta":110},"kv3t",{"title":109,"type":51},{"id":112,"meta":113},"studiomdl",{"title":112,"type":51},{"id":115,"meta":116},"vbsp",{"title":115,"type":51},{"id":118,"meta":119},"vfont",{"title":118,"type":51},{"id":121,"meta":122},"vrad",{"title":121,"type":51},{"id":124,"meta":125},"vtex",{"title":124,"type":51},{"id":127,"meta":128},"vtex2",{"title":127,"type":51},{"id":130,"meta":131},"vvis",{"title":130,"type":51},[],{"id":134,"title":135,"type":51,"articles":136,"subtopics":146},"modding/workshop","Workshop",[137,141],{"id":138,"meta":139},"workshopoverview",{"title":135,"features":140,"type":51},[36],{"id":142,"meta":143},"workshopgui",{"title":144,"features":145,"type":51},"Workshop Uploader GUI",[36],[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":673,"topicID":676},false,{"type":3,"children":4,"position":668},"root",[5,16,33,49,63,79,94,349,363,392,402,492,506,515,528,574,582,648],{"type":6,"value":7,"position":8},"yaml","title: VTF v7.6 Format",{"start":9,"end":12},{"line":10,"column":10,"offset":11},1,0,{"line":13,"column":14,"offset":15},3,4,30,{"type":17,"depth":10,"children":18,"position":29},"heading",[19],{"type":20,"value":21,"position":22},"text","VTF Version 7.6",{"start":23,"end":26},{"line":24,"column":13,"offset":25},5,34,{"line":24,"column":27,"offset":28},18,49,{"start":30,"end":32},{"line":24,"column":10,"offset":31},32,{"line":24,"column":27,"offset":28},{"type":34,"children":35,"position":46},"paragraph",[36],{"type":20,"value":37,"position":38},"VTF v7.6 is Strata Source's modified VTF format that adds a few new image formats, as well as optional CPU compression.\nThis document goes over all additions to the format.",{"start":39,"end":42},{"line":40,"column":10,"offset":41},7,51,{"line":43,"column":44,"offset":45},8,53,223,{"start":47,"end":48},{"line":40,"column":10,"offset":41},{"line":43,"column":44,"offset":45},{"type":34,"children":50,"position":60},[51],{"type":20,"value":52,"position":53},"No changes have been made to the header's fields. The header is identical to VTF v7.5.",{"start":54,"end":57},{"line":55,"column":10,"offset":56},10,225,{"line":55,"column":58,"offset":59},87,311,{"start":61,"end":62},{"line":55,"column":10,"offset":56},{"line":55,"column":58,"offset":59},{"type":17,"depth":64,"children":65,"position":75},2,[66],{"type":20,"value":67,"position":68},"New Texture Formats",{"start":69,"end":72},{"line":70,"column":14,"offset":71},12,316,{"line":70,"column":73,"offset":74},23,335,{"start":76,"end":78},{"line":70,"column":10,"offset":77},313,{"line":70,"column":73,"offset":74},{"type":34,"children":80,"position":91},[81],{"type":20,"value":82,"position":83},"A few new texture formats are present in Strata Source. These will technically work in any VTF version loaded by a Strata Source\ngame, but it is recommended to only use them in v7.6 VTFs so there isn't any confusion about why the textures will not work in\nolder Source engine games.",{"start":84,"end":87},{"line":85,"column":10,"offset":86},14,337,{"line":88,"column":89,"offset":90},16,27,619,{"start":92,"end":93},{"line":85,"column":10,"offset":86},{"line":88,"column":89,"offset":90},{"type":95,"align":96,"children":98,"position":346},"table",[97,97,97],null,[99,150,237,298],{"type":100,"children":101,"position":147},"tableRow",[102,117,131],{"type":103,"children":104,"position":112},"tableCell",[105],{"type":20,"value":106,"position":107},"Name",{"start":108,"end":110},{"line":27,"column":13,"offset":109},623,{"line":27,"column":40,"offset":111},627,{"start":113,"end":115},{"line":27,"column":10,"offset":114},621,{"line":27,"column":55,"offset":116},630,{"type":103,"children":118,"position":127},[119],{"type":20,"value":120,"position":121},"Value",{"start":122,"end":124},{"line":27,"column":70,"offset":123},632,{"line":27,"column":125,"offset":126},17,637,{"start":128,"end":129},{"line":27,"column":55,"offset":116},{"line":27,"column":27,"offset":130},638,{"type":103,"children":132,"position":142},[133],{"type":20,"value":134,"position":135},"Description",{"start":136,"end":139},{"line":27,"column":137,"offset":138},20,640,{"line":27,"column":140,"offset":141},31,651,{"start":143,"end":144},{"line":27,"column":27,"offset":130},{"line":27,"column":145,"offset":146},190,810,{"start":148,"end":149},{"line":27,"column":10,"offset":114},{"line":27,"column":145,"offset":146},{"type":100,"children":151,"position":234},[152,167,180],{"type":103,"children":153,"position":162},[154],{"type":155,"value":156,"position":157},"inlineCode","R8",{"start":158,"end":160},{"line":137,"column":13,"offset":159},1003,{"line":137,"column":40,"offset":161},1007,{"start":163,"end":165},{"line":137,"column":10,"offset":164},1001,{"line":137,"column":55,"offset":166},1010,{"type":103,"children":168,"position":176},[169],{"type":155,"value":170,"position":171},"69",{"start":172,"end":174},{"line":137,"column":70,"offset":173},1012,{"line":137,"column":88,"offset":175},1016,{"start":177,"end":178},{"line":137,"column":55,"offset":166},{"line":137,"column":27,"offset":179},1018,{"type":103,"children":181,"position":230},[182,190,197,204,210,217,223],{"type":20,"value":183,"position":184},"Identical to ",{"start":185,"end":187},{"line":137,"column":137,"offset":186},1020,{"line":137,"column":188,"offset":189},33,1033,{"type":155,"value":191,"position":192},"I8",{"start":193,"end":194},{"line":137,"column":188,"offset":189},{"line":137,"column":195,"offset":196},37,1037,{"type":20,"value":198,"position":199},", except where ",{"start":200,"end":201},{"line":137,"column":195,"offset":196},{"line":137,"column":202,"offset":203},52,1052,{"type":155,"value":191,"position":205},{"start":206,"end":207},{"line":137,"column":202,"offset":203},{"line":137,"column":208,"offset":209},56,1056,{"type":20,"value":211,"position":212}," is treated as greyscale ",{"start":213,"end":214},{"line":137,"column":208,"offset":209},{"line":137,"column":215,"offset":216},81,1081,{"type":155,"value":156,"position":218},{"start":219,"end":220},{"line":137,"column":215,"offset":216},{"line":137,"column":221,"offset":222},85,1085,{"type":20,"value":224,"position":225}," is purely a red channel. No practical benefit to using this format outside internal engine operations.",{"start":226,"end":227},{"line":137,"column":221,"offset":222},{"line":137,"column":228,"offset":229},188,1188,{"start":231,"end":232},{"line":137,"column":27,"offset":179},{"line":137,"column":145,"offset":233},1190,{"start":235,"end":236},{"line":137,"column":10,"offset":164},{"line":137,"column":145,"offset":233},{"type":100,"children":238,"position":295},[239,254,267],{"type":103,"children":240,"position":249},[241],{"type":155,"value":242,"position":243},"BC7",{"start":244,"end":247},{"line":245,"column":13,"offset":246},21,1193,{"line":245,"column":43,"offset":248},1198,{"start":250,"end":252},{"line":245,"column":10,"offset":251},1191,{"line":245,"column":55,"offset":253},1200,{"type":103,"children":255,"position":263},[256],{"type":155,"value":257,"position":258},"70",{"start":259,"end":261},{"line":245,"column":70,"offset":260},1202,{"line":245,"column":88,"offset":262},1206,{"start":264,"end":265},{"line":245,"column":55,"offset":253},{"line":245,"column":27,"offset":266},1208,{"type":103,"children":268,"position":291},[269,277,284],{"type":20,"value":270,"position":271},"This format is recommended as a replacement for ",{"start":272,"end":274},{"line":245,"column":137,"offset":273},1210,{"line":245,"column":275,"offset":276},68,1258,{"type":155,"value":278,"position":279},"DXT5",{"start":280,"end":281},{"line":245,"column":275,"offset":276},{"line":245,"column":282,"offset":283},74,1264,{"type":20,"value":285,"position":286},". The alpha channel is optional.",{"start":287,"end":288},{"line":245,"column":282,"offset":283},{"line":245,"column":289,"offset":290},106,1296,{"start":292,"end":293},{"line":245,"column":27,"offset":266},{"line":245,"column":145,"offset":294},1380,{"start":296,"end":297},{"line":245,"column":10,"offset":251},{"line":245,"column":145,"offset":294},{"type":100,"children":299,"position":343},[300,316,329],{"type":103,"children":301,"position":311},[302],{"type":155,"value":303,"position":304},"BC6H",{"start":305,"end":308},{"line":306,"column":13,"offset":307},22,1383,{"line":306,"column":309,"offset":310},9,1389,{"start":312,"end":314},{"line":306,"column":10,"offset":313},1381,{"line":306,"column":55,"offset":315},1390,{"type":103,"children":317,"position":325},[318],{"type":155,"value":319,"position":320},"71",{"start":321,"end":323},{"line":306,"column":70,"offset":322},1392,{"line":306,"column":88,"offset":324},1396,{"start":326,"end":327},{"line":306,"column":55,"offset":315},{"line":306,"column":27,"offset":328},1398,{"type":103,"children":330,"position":339},[331],{"type":20,"value":332,"position":333},"Used to store cubemaps, and recommended for HDR textures. This is the signed half-float variant.",{"start":334,"end":336},{"line":306,"column":137,"offset":335},1400,{"line":306,"column":337,"offset":338},116,1496,{"start":340,"end":341},{"line":306,"column":27,"offset":328},{"line":306,"column":145,"offset":342},1570,{"start":344,"end":345},{"line":306,"column":10,"offset":313},{"line":306,"column":145,"offset":342},{"start":347,"end":348},{"line":27,"column":10,"offset":114},{"line":306,"column":145,"offset":342},{"type":17,"depth":64,"children":350,"position":359},[351],{"type":20,"value":352,"position":353},"New Resources",{"start":354,"end":357},{"line":355,"column":14,"offset":356},24,1575,{"line":355,"column":125,"offset":358},1588,{"start":360,"end":362},{"line":355,"column":10,"offset":361},1572,{"line":355,"column":125,"offset":358},{"type":34,"children":364,"position":389},[365,374,381],{"type":20,"value":366,"position":367},"There is one new resource in VTF v7.6. The \"Auxiliary Compression Info\" resource (",{"start":368,"end":371},{"line":369,"column":10,"offset":370},26,1590,{"line":369,"column":372,"offset":373},83,1672,{"type":155,"value":375,"position":376},"AXC",{"start":377,"end":378},{"line":369,"column":372,"offset":373},{"line":369,"column":379,"offset":380},88,1677,{"type":20,"value":382,"position":383}," identifier) controls CPU compression\nof texture data. The first version of this resource is supported by all Strata Source games, and has the following structure,\nexcluding the length integer present in every non-legacy resource:",{"start":384,"end":385},{"line":369,"column":379,"offset":380},{"line":386,"column":387,"offset":388},28,67,1907,{"start":390,"end":391},{"line":369,"column":10,"offset":370},{"line":386,"column":387,"offset":388},{"type":393,"lang":394,"meta":97,"value":395,"position":396},"code","cpp","struct AXC_v1 {\n    uint32_t compression_strength;\n    uint32_t compressed_sizes[mip_count * frame_count * face_count];\n};",{"start":397,"end":399},{"line":15,"column":10,"offset":398},1909,{"line":400,"column":14,"offset":401},35,2042,{"type":34,"children":403,"position":489},[404,412,429,436,442,449,456,463,470,477,482],{"type":20,"value":405,"position":406},"The only supported compression method for this version is ",{"start":407,"end":409},{"line":195,"column":10,"offset":408},2044,{"line":195,"column":410,"offset":411},59,2102,{"type":413,"title":97,"url":414,"children":415,"position":424},"link","https://en.wikipedia.org/wiki/Deflate",[416],{"type":20,"value":417,"position":418},"Deflate",{"start":419,"end":422},{"line":195,"column":420,"offset":421},60,2103,{"line":195,"column":387,"offset":423},2110,{"start":425,"end":426},{"line":195,"column":410,"offset":411},{"line":195,"column":427,"offset":428},107,2150,{"type":20,"value":430,"position":431},". The compression\nstrength can be ",{"start":432,"end":433},{"line":195,"column":427,"offset":428},{"line":434,"column":125,"offset":435},38,2184,{"type":155,"value":437,"position":438},"-1",{"start":439,"end":440},{"line":434,"column":125,"offset":435},{"line":434,"column":245,"offset":441},2188,{"type":20,"value":443,"position":444}," (default compression strength), ",{"start":445,"end":446},{"line":434,"column":245,"offset":441},{"line":434,"column":447,"offset":448},54,2221,{"type":155,"value":450,"position":451},"0",{"start":452,"end":453},{"line":434,"column":447,"offset":448},{"line":434,"column":454,"offset":455},57,2224,{"type":20,"value":457,"position":458}," (no compression was applied), or ",{"start":459,"end":460},{"line":434,"column":454,"offset":455},{"line":434,"column":461,"offset":462},91,2258,{"type":155,"value":464,"position":465},"1-9",{"start":466,"end":467},{"line":434,"column":461,"offset":462},{"line":434,"column":468,"offset":469},96,2263,{"type":20,"value":471,"position":472}," (specific compression strength).\nIf the compression strength is ",{"start":473,"end":474},{"line":434,"column":468,"offset":469},{"line":475,"column":31,"offset":476},39,2328,{"type":155,"value":450,"position":478},{"start":479,"end":480},{"line":475,"column":31,"offset":476},{"line":475,"column":400,"offset":481},2331,{"type":20,"value":483,"position":484}," the VTF is assumed to be uncompressed and the resource is ignored.",{"start":485,"end":486},{"line":475,"column":400,"offset":481},{"line":475,"column":487,"offset":488},102,2398,{"start":490,"end":491},{"line":195,"column":10,"offset":408},{"line":475,"column":487,"offset":488},{"type":34,"children":493,"position":503},[494],{"type":20,"value":495,"position":496},"The compressed sizes array is structured similarly to how VTF texture data is structured. In pseudocode:",{"start":497,"end":500},{"line":498,"column":10,"offset":499},41,2400,{"line":498,"column":501,"offset":502},105,2504,{"start":504,"end":505},{"line":498,"column":10,"offset":499},{"line":498,"column":501,"offset":502},{"type":393,"lang":97,"meta":97,"value":507,"position":508},"for each mip level:\n    for each frame:\n        for each face:\n            uint32_t compressed_size",{"start":509,"end":512},{"line":510,"column":10,"offset":511},43,2506,{"line":513,"column":14,"offset":514},48,2613,{"type":34,"children":516,"position":525},[517],{"type":20,"value":518,"position":519},"The array stores the compressed size of each piece of texture data. They are compressed separately to avoid having to decompress\nthe entire VTF every time a different part of it is accessed. 3D textures (textures with more than one slice) are compressed as one\nunit rather than compressing each individual slice. The uncompressed size can be calculated from the texture dimensions and format.\nTo calculate the offset of a texture into the image resource at a given mip, frame, and face, the size of every compressed texture\nbefore it must be added together.",{"start":520,"end":523},{"line":521,"column":10,"offset":522},50,2615,{"line":447,"column":25,"offset":524},3172,{"start":526,"end":527},{"line":521,"column":10,"offset":522},{"line":447,"column":25,"offset":524},{"type":34,"children":529,"position":571},[530,537,542,548,564],{"type":20,"value":531,"position":532},"The second and most recent version of the ",{"start":533,"end":535},{"line":208,"column":10,"offset":534},3174,{"line":208,"column":510,"offset":536},3216,{"type":155,"value":375,"position":538},{"start":539,"end":540},{"line":208,"column":510,"offset":536},{"line":208,"column":513,"offset":541},3221,{"type":20,"value":543,"position":544}," resource introduces a field to control the compression method, and adds support for\n",{"start":545,"end":546},{"line":208,"column":513,"offset":541},{"line":454,"column":10,"offset":547},3306,{"type":413,"title":97,"url":549,"children":550,"position":559},"https://facebook.github.io/zstd/",[551],{"type":20,"value":552,"position":553},"Zstandard",{"start":554,"end":556},{"line":454,"column":64,"offset":555},3307,{"line":454,"column":557,"offset":558},11,3316,{"start":560,"end":561},{"line":454,"column":10,"offset":547},{"line":454,"column":562,"offset":563},46,3351,{"type":20,"value":565,"position":566}," compression. The structure of the resource is now:",{"start":567,"end":568},{"line":454,"column":562,"offset":563},{"line":454,"column":569,"offset":570},97,3402,{"start":572,"end":573},{"line":208,"column":10,"offset":534},{"line":454,"column":569,"offset":570},{"type":393,"lang":394,"meta":97,"value":575,"position":576},"// These values match minizip defines, but keep in\n// mind they are the only ones supported right now\nuint16_t METHOD_DEFLATE = 8;\nuint16_t METHOD_ZSTD = 93;\n\nstruct AXC_v2 {\n    uint16_t compression_strength;\n    uint16_t compression_method;\n    uint32_t compressed_sizes[mip_count * frame_count * face_count];\n};",{"start":577,"end":579},{"line":410,"column":10,"offset":578},3404,{"line":580,"column":14,"offset":581},70,3729,{"type":34,"children":583,"position":645},[584,592,598,605,611,618,625,632,638],{"type":20,"value":585,"position":586},"The version of the ",{"start":587,"end":590},{"line":588,"column":10,"offset":589},72,3731,{"line":588,"column":137,"offset":591},3750,{"type":155,"value":375,"position":593},{"start":594,"end":595},{"line":588,"column":137,"offset":591},{"line":588,"column":596,"offset":597},25,3755,{"type":20,"value":599,"position":600}," resource can be determined using the compression method field. If the field is less than or equal to ",{"start":601,"end":602},{"line":588,"column":596,"offset":597},{"line":588,"column":603,"offset":604},127,3857,{"type":155,"value":450,"position":606},{"start":607,"end":608},{"line":588,"column":603,"offset":604},{"line":588,"column":609,"offset":610},130,3860,{"type":20,"value":612,"position":613},",\nthe resource is the original, and the compression method is known to be Deflate. If the field is either ",{"start":614,"end":615},{"line":588,"column":609,"offset":610},{"line":616,"column":501,"offset":617},73,3966,{"type":155,"value":619,"position":620},"8",{"start":621,"end":622},{"line":616,"column":501,"offset":617},{"line":616,"column":623,"offset":624},108,3969,{"type":20,"value":626,"position":627}," or ",{"start":628,"end":629},{"line":616,"column":623,"offset":624},{"line":616,"column":630,"offset":631},112,3973,{"type":155,"value":633,"position":634},"93",{"start":635,"end":636},{"line":616,"column":630,"offset":631},{"line":616,"column":337,"offset":637},3977,{"type":20,"value":639,"position":640}," (the only supported\nvalues currently) then the resource is the second iteration, and the value can be relied on to determine the compression method.\nIf the compression method lies outside this domain the VTF is malformed.",{"start":641,"end":642},{"line":616,"column":337,"offset":637},{"line":643,"column":616,"offset":644},75,4199,{"start":646,"end":647},{"line":588,"column":10,"offset":589},{"line":643,"column":616,"offset":644},{"type":649,"children":650,"position":664},"blockquote",[651],{"type":34,"children":652,"position":661},[653],{"type":20,"value":654,"position":655},"[!REVOLUTION]\nThe second version of this resource is unsupported in Portal: Revolution when compressing with Zstandard. Portal: Revolution is expecting\nthe original version of the resource, and cannot decode Zstandard compression. Due to the resource's forwards and backwards compatibility\nhowever, as long as Deflate compression is specified when creating a compressed VTF Portal: Revolution will support that VTF, even though\nit may be using the updated resource definition.",{"start":656,"end":659},{"line":657,"column":13,"offset":658},77,4203,{"line":215,"column":41,"offset":660},4687,{"start":662,"end":663},{"line":657,"column":13,"offset":658},{"line":215,"column":41,"offset":660},{"start":665,"end":667},{"line":657,"column":10,"offset":666},4201,{"line":215,"column":41,"offset":660},{"start":669,"end":670},{"line":10,"column":10,"offset":11},{"line":671,"column":10,"offset":672},82,4688,{"title":674,"type":675},"VTF v7.6 Format","markdown","modding/overview"],"uses":{"params":["category","article"]}}]}
