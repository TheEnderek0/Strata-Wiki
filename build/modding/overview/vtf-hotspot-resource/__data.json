ding and writing hotspot information directly into textures, so that hotspot editing tools may be created that work seamlessly without any additional material configuration.",{"start":39,"end":42},{"line":40,"column":10,"offset":41},7,67,{"line":40,"column":43,"offset":44},238,304,{"start":46,"end":47},{"line":40,"column":10,"offset":41},{"line":40,"column":43,"offset":44},{"type":34,"children":49,"position":84},[50,59,77],{"type":20,"value":51,"position":52},"For the external text-based format, see the ",{"start":53,"end":56},{"line":54,"column":10,"offset":55},9,306,{"line":54,"column":57,"offset":58},45,350,{"type":60,"title":61,"url":62,"children":63,"position":72},"link",null,"./vtf-hotspot-text-format",[64],{"type":20,"value":65,"position":66},"Hotspot Text Format",{"start":67,"end":70},{"line":54,"column":68,"offset":69},46,351,{"line":54,"column":28,"offset":71},370,{"start":73,"end":74},{"line":54,"column":57,"offset":58},{"line":54,"column":75,"offset":76},93,398,{"type":20,"value":78,"position":79},".",{"start":80,"end":81},{"line":54,"column":75,"offset":76},{"line":54,"column":82,"offset":83},94,399,{"start":85,"end":86},{"line":54,"column":10,"offset":55},{"line":54,"column":82,"offset":83},{"type":17,"depth":88,"children":89,"position":99},2,[90],{"type":20,"value":91,"position":92},"Hotspot Resource Specification",{"start":93,"end":96},{"line":94,"column":14,"offset":95},11,404,{"line":94,"column":97,"offset":98},34,434,{"start":100,"end":102},{"line":94,"column":10,"offset":101},401,{"line":94,"column":97,"offset":98},{"type":34,"children":104,"position":114},[105],{"type":20,"value":106,"position":107},"This specification describes the Hotspot resource for embedding in VTFs greater than version 7.2. All structs in this resource should be assumed to be byte-aligned without padding.",{"start":108,"end":111},{"line":109,"column":10,"offset":110},13,436,{"line":109,"column":112,"offset":113},181,616,{"start":115,"end":116},{"line":109,"column":10,"offset":110},{"line":109,"column":112,"offset":113},{"type":34,"children":118,"position":128},[119],{"type":20,"value":120,"position":121},"This resource does not include world texel-scaling information, and assumes that implementations will attempt to match rects with the default texture scale as defined in the user configuration.",{"start":122,"end":125},{"line":123,"column":10,"offset":124},15,618,{"line":123,"column":126,"offset":127},194,811,{"start":129,"end":130},{"line":123,"column":10,"offset":124},{"line":123,"column":126,"offset":127},{"type":34,"children":132,"position":142},[133],{"type":20,"value":134,"position":135},"Due to the need for compatibility across many games, this resource cannot rely on the VTF version for possible format changes, and instead contains its own version in the body.",{"start":136,"end":139},{"line":137,"column":10,"offset":138},17,813,{"line":137,"column":140,"offset":141},177,989,{"start":143,"end":144},{"line":137,"column":10,"offset":138},{"line":137,"column":140,"offset":141},{"type":17,"depth":88,"children":146,"position":156},[147],{"type":20,"value":148,"position":149},"Header",{"start":150,"end":153},{"line":151,"column":14,"offset":152},19,994,{"line":151,"column":154,"offset":155},10,1000,{"start":157,"end":159},{"line":151,"column":10,"offset":158},991,{"line":151,"column":154,"offset":155},{"type":34,"children":161,"position":211},[162,171,178,184,191,198,205],{"type":20,"value":163,"position":164},"This resource uses the UTF-8 tag \"",{"start":165,"end":168},{"line":166,"column":10,"offset":167},21,1002,{"line":166,"column":169,"offset":170},35,1036,{"type":172,"value":173,"position":174},"inlineCode","+\\0\\0",{"start":175,"end":176},{"line":166,"column":169,"offset":170},{"line":166,"column":25,"offset":177},1043,{"type":20,"value":179,"position":180},"\" (",{"start":181,"end":182},{"line":166,"column":25,"offset":177},{"line":166,"column":57,"offset":183},1046,{"type":172,"value":185,"position":186},"2B 00 00",{"start":187,"end":188},{"line":166,"column":57,"offset":183},{"line":166,"column":189,"offset":190},55,1056,{"type":20,"value":192,"position":193}," in hexadecimal) for identification. This non-trivial name is due to several limitations - the resource must be inserted prior to the high-res data resource to avoid buffering issues, and resources are expected to be sorted in ascending order by their tags as little-endian integers. These force us to use an ID with a total value less than ",{"start":194,"end":195},{"line":166,"column":189,"offset":190},{"line":166,"column":196,"offset":197},396,1397,{"type":172,"value":199,"position":200},"0x000030",{"start":201,"end":202},{"line":166,"column":196,"offset":197},{"line":166,"column":203,"offset":204},406,1407,{"type":20,"value":78,"position":206},{"start":207,"end":208},{"line":166,"column":203,"offset":204},{"line":166,"column":209,"offset":210},407,1408,{"start":212,"end":213},{"line":166,"column":10,"offset":167},{"line":166,"column":209,"offset":210},{"type":34,"children":215,"position":225},[216],{"type":20,"value":217,"position":218},"No additional flags are defined in the resource header flags field.",{"start":219,"end":222},{"line":220,"column":10,"offset":221},23,1410,{"line":220,"column":223,"offset":224},68,1477,{"start":226,"end":227},{"line":220,"column":10,"offset":221},{"line":220,"column":223,"offset":224},{"type":17,"depth":88,"children":229,"position":239},[230],{"type":20,"value":231,"position":232},"Body",{"start":233,"end":236},{"line":234,"column":14,"offset":235},25,1482,{"line":234,"column":237,"offset":238},8,1486,{"start":240,"end":242},{"line":234,"column":10,"offset":241},1479,{"line":234,"column":237,"offset":238},{"type":34,"children":244,"position":254},[245],{"type":20,"value":246,"position":247},"The resource body begins with the following header:",{"start":248,"end":251},{"line":249,"column":10,"offset":250},27,1488,{"line":249,"column":252,"offset":253},52,1539,{"start":255,"end":256},{"line":249,"column":10,"offset":250},{"line":249,"column":252,"offset":253},{"type":258,"lang":259,"meta":61,"value":260,"position":261},"code","cpp","struct HotspotHeader_t {\n\tunsigned char  version;    // The resource version. Currently 0x1\n\tunsigned char  flags;      // Implementation-specific flags for editors.\n\tunsigned short rect_count; // The number of rect regions.\n};",{"start":262,"end":265},{"line":263,"column":10,"offset":264},29,1541,{"line":169,"column":14,"offset":266},1779,{"type":34,"children":268,"position":278},[269],{"type":20,"value":270,"position":271},"Following immediately after are a contiguous array of rect regions. These regions use the following structure:",{"start":272,"end":275},{"line":273,"column":10,"offset":274},37,1781,{"line":273,"column":276,"offset":277},111,1891,{"start":279,"end":280},{"line":273,"column":10,"offset":274},{"line":273,"column":276,"offset":277},{"type":258,"lang":259,"meta":61,"value":282,"position":283},"struct HotspotRect_t {\n\tHotspotRectFlags_t flags; // See below section.\n\tunsigned short min_x;     // Coordinates are stored in pixels.\n\tunsigned short min_y;\n\tunsigned short max_x;\n\tunsigned short max_y;\n};",{"start":284,"end":287},{"line":285,"column":10,"offset":286},39,1893,{"line":288,"column":14,"offset":289},47,2111,{"type":34,"children":291,"position":300},[292],{"type":20,"value":293,"position":294},"Orientation randomization is defined within the flags of each rect. Although these are defined per-rect, it is recommended that editors implement batch editing for ease of use.",{"start":295,"end":298},{"line":296,"column":10,"offset":297},49,2113,{"line":296,"column":140,"offset":299},2289,{"start":301,"end":302},{"line":296,"column":10,"offset":297},{"line":296,"column":140,"offset":299},{"type":34,"children":304,"position":327},[305,314,320],{"type":20,"value":306,"position":307},"Regions with the ",{"start":308,"end":311},{"line":309,"column":10,"offset":310},51,2291,{"line":309,"column":312,"offset":313},18,2308,{"type":172,"value":315,"position":316},"alt_group",{"start":317,"end":318},{"line":309,"column":312,"offset":313},{"line":309,"column":263,"offset":319},2319,{"type":20,"value":321,"position":322}," flag should be excluded from random selection by default, and be exclusively randomly selected when an implementation-specific modifier key is active. For consistency, the left-hand Alt key is recommended for this purpose.",{"start":323,"end":324},{"line":309,"column":263,"offset":319},{"line":309,"column":325,"offset":326},252,2542,{"start":328,"end":329},{"line":309,"column":10,"offset":310},{"line":309,"column":325,"offset":326},{"type":258,"lang":259,"meta":61,"value":331,"position":332},"enum class HotspotRectFlags_t : unsigned char {\n\tenable_rotation   = 0x1, // Should this region be randomly rotated?\n\tenable_reflection = 0x2, // Should this region be randomly horizontally flipped?\n\talt_group         = 0x4, // If true, this region belongs to the alternate group.\n};",{"start":333,"end":336},{"line":334,"column":10,"offset":335},53,2544,{"line":337,"column":14,"offset":338},59,2838,{"start":340,"end":341},{"line":10,"column":10,"offset":11},{"line":342,"column":10,"offset":343},60,2839,{"title":21,"type":345},"markdown","modding/overview"],"uses":{"params":["category","article"]}}]}
