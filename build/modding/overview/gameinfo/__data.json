41,"column":13,"offset":244},1650,{"line":41,"column":44,"offset":246},1694,{"type":89,"value":248,"position":249},"gamebin",{"start":250,"end":251},{"line":41,"column":44,"offset":246},{"line":41,"column":152,"offset":252},1703,{"type":20,"value":254,"position":255}," entry from the\n",{"start":256,"end":257},{"line":41,"column":152,"offset":252},{"line":258,"column":10,"offset":259},64,1719,{"type":89,"value":186,"position":261},{"start":262,"end":263},{"line":258,"column":10,"offset":259},{"line":258,"column":264,"offset":265},14,1732,{"type":20,"value":267,"position":268}," block. This will cause the game to attempt to load binaries from\nyour mod's bin directory instead of P2CE's.",{"start":269,"end":270},{"line":258,"column":264,"offset":265},{"line":271,"column":272,"offset":273},65,44,1841,{"start":275,"end":276},{"line":41,"column":13,"offset":244},{"line":271,"column":272,"offset":273},{"start":278,"end":280},{"line":41,"column":10,"offset":279},1648,{"line":271,"column":272,"offset":273},{"type":236,"spread":1,"checked":122,"children":282,"position":323},[283],{"type":34,"children":284,"position":320},[285,293,299,306,313],{"type":20,"value":286,"position":287},"When adding p2ce to your gameinfo, add it as ",{"start":288,"end":291},{"line":289,"column":13,"offset":290},67,1845,{"line":289,"column":94,"offset":292},1890,{"type":89,"value":294,"position":295},"game+mod",{"start":296,"end":297},{"line":289,"column":94,"offset":292},{"line":289,"column":166,"offset":298},1900,{"type":20,"value":300,"position":301},". Otherwise, the game will not be\nable to find ",{"start":302,"end":303},{"line":289,"column":166,"offset":298},{"line":304,"column":264,"offset":305},68,1947,{"type":89,"value":307,"position":308},"steam.inf",{"start":309,"end":310},{"line":304,"column":264,"offset":305},{"line":304,"column":311,"offset":312},25,1958,{"type":20,"value":314,"position":315}," unless your mod ships it.",{"start":316,"end":317},{"line":304,"column":311,"offset":312},