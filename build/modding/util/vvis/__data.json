92,"meta":93},"p2ce-mod-template",{"title":94,"type":51},"P2:CE Mod Template",{"id":96,"meta":97},"vtf-v76",{"title":98,"type":51},"VTF v7.6 Format",[],{"id":101,"title":102,"weight":103,"type":51,"articles":104,"subtopics":132},"modding/util","Utilities",50,[105,108,111,114,117,120,123,126,129],{"id":106,"meta":107},"dmxconvert",{"title":106,"type":51},{"id":109,"meta":110},"kv3t",{"title":109,"type":51},{"id":112,"meta":113},"studiomdl",{"title":112,"type":51},{"id":115,"meta":116},"vbsp",{"title":115,"type":51},{"id":118,"meta":119},"vfont",{"title":118,"type":51},{"id":121,"meta":122},"vrad",{"title":121,"type":51},{"id":124,"meta":125},"vtex",{"title":124,"type":51},{"id":127,"meta":128},"vtex2",{"title":127,"type":51},{"id":130,"meta":131},"vvis",{"title":130,"type":51},[],{"id":134,"title":135,"type":51,"articles":136,"subtopics":146},"modding/workshop","Workshop",[137,141],{"id":138,"meta":139},"workshopoverview",{"title":135,"features":140,"type":51},[36],{"id":142,"meta":143},"workshopgui",{"title":144,"features":145,"type":51},"Workshop Uploader GUI",[36],[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":77,"topicID":79},false,{"type":3,"children":4,"position":74},"root",[5,16,33,47,63],{"type":6,"value":7,"position":8},"yaml","title: vvis",{"start":9,"end":12},{"line":10,"column":10,"offset":11},1,0,{"line":13,"column":14,"offset":15},3,4,19,{"type":17,"depth":10,"children":18,"position":29},"heading",[19],{"type":20,"value":21,"position":22},"text","vvis",{"start":23,"end":26},{"line":24,"column":13,"offset":25},5,23,{"line":24,"column":27,"offset":28},7,27,{"start":30,"end":32},{"line":24,"column":10,"offset":31},21,{"line":24,"column":27,"offset":28},{"type":34,"children":35,"position":44},"paragraph",[36],{"type":20,"value":37,"position":38},"vvis is a command line utility that builds the visibility tree for BSP files. It is available for Windows and Linux.",{"start":39,"end":41},{"line":27,"column":10,"offset":40},29,{"line":27,"column":42,"offset":43},117,145,{"start":45,"end":46},{"line":27,"column":10,"offset":40},{"line":27,"column":42,"offset":43},{"type":17,"depth":48,"children":49,"position":59},2,[50],{"type":20,"value":51,"position":52},"Help Text",{"start":53,"end":56},{"line":54,"column":14,"offset":55},9,150,{"line":54,"column":57,"offset":58},13,159,{"start":60,"end":62},{"line":54,"column":10,"offset":61},147,{"line":54,"column":57,"offset":58},{"type":64,"lang":65,"meta":65,"value":66,"position":67},"code",null,"Valve Software - vvis.exe (Nov  9 2024)\n\nusage  : vvis [options...] bspfile\nexample: vvis -fast c:\\hl2\\hl2\\maps\\test\n\nCommon options:\n\n  -v (or -verbose): Turn on verbose output (also shows more command\n  -fast           : Only do first quick pass on vis calculations.\n  -mpi            : Use VMPI to distribute computations.\n  -low            : Run as an idle-priority process.\n\n  -vproject \u003Cdirectory> : Override the VPROJECT environment variable.\n  -game \u003Cdirectory>     : Same as -vproject.\n\nOther options:\n  -radius_override: Force a vis radius, regardless of whether an env_fog_controller specifies one.\n  -mpi_pw \u003Cpw>    : Use a password to choose a specific set of VMPI workers.\n  -threads        : Control the number of threads vbsp uses (defaults to the # or processors on your machine).\n  -nosort         : Don't sort portals (sorting is an optimization).\n  -tmpin          : Make portals come from \\tmp\\\u003Cmapname>.\n  -tmpout         : Make portals come from \\tmp\\\u003Cmapname>.\n  -trace \u003Cstart cluster> \u003Cend cluster> : Writes a linefile that traces the vis from one cluster to another for debugging map vis.\n  -FullMinidumps  : Write large minidumps on crash.",{"start":68,"end":71},{"line":69,"column":10,"offset":70},10,160,{"line":72,"column":14,"offset":73},35,1334,{"start":75,"end":76},{"line":10,"column":10,"offset":11},{"line":72,"column":14,"offset":73},{"title":21,"type":78},"markdown","modding/util"],"uses":{"params":["category","article"]}}]}
