92,"meta":93},"p2ce-mod-template",{"title":94,"type":51},"P2:CE Mod Template",{"id":96,"meta":97},"vtf-v76",{"title":98,"type":51},"VTF v7.6 Format",[],{"id":101,"title":102,"weight":103,"type":51,"articles":104,"subtopics":132},"modding/util","Utilities",50,[105,108,111,114,117,120,123,126,129],{"id":106,"meta":107},"dmxconvert",{"title":106,"type":51},{"id":109,"meta":110},"kv3t",{"title":109,"type":51},{"id":112,"meta":113},"studiomdl",{"title":112,"type":51},{"id":115,"meta":116},"vbsp",{"title":115,"type":51},{"id":118,"meta":119},"vfont",{"title":118,"type":51},{"id":121,"meta":122},"vrad",{"title":121,"type":51},{"id":124,"meta":125},"vtex",{"title":124,"type":51},{"id":127,"meta":128},"vtex2",{"title":127,"type":51},{"id":130,"meta":131},"vvis",{"title":130,"type":51},[],{"id":134,"title":135,"type":51,"articles":136,"subtopics":146},"modding/workshop","Workshop",[137,141],{"id":138,"meta":139},"workshopoverview",{"title":135,"features":140,"type":51},[36],{"id":142,"meta":143},"workshopgui",{"title":144,"features":145,"type":51},"Workshop Uploader GUI",[36],[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":139,"topicID":144},false,{"type":3,"children":4,"position":134},"root",[5,16,34,49,65,105,120],{"type":6,"value":7,"position":8},"yaml","title: \"Workshop\"\nfeatures:\n    - USE_UGC",{"start":9,"end":12},{"line":10,"column":10,"offset":11},1,0,{"line":13,"column":14,"offset":15},5,4,49,{"type":17,"depth":10,"children":18,"position":30},"heading",[19],{"type":20,"value":21,"position":22},"text","The Workshop: What Is It?",{"start":23,"end":27},{"line":24,"column":25,"offset":26},6,3,52,{"line":24,"column":28,"offset":29},28,77,{"start":31,"end":33},{"line":24,"column":10,"offset":32},50,{"line":24,"column":28,"offset":29},{"type":35,"children":36,"position":46},"paragraph",[37],{"type":20,"value":38,"position":39},"Like Portal 2, Portal 2: Community Edition has a workshop where users can upload their own maps for others to play. Portal 2: CE's workshop, however, can do much more than just maps. Similar to the Left 4 Dead 2 and Black Mesa workshops, entire mod-packs or multi-map campaigns can be in the same addon. But it doesn't have to be just maps, addons can consist of just material reskins or remodels, or even entire game ports.",{"start":40,"end":43},{"line":41,"column":10,"offset":42},8,79,{"line":41,"column":44,"offset":45},425,503,{"start":47,"end":48},{"line":41,"column":10,"offset":42},{"line":41,"column":44,"offset":45},{"type":17,"depth":50,"children":51,"position":61},2,[52],{"type":20,"value":53,"position":54},"How do I upload an addon to the workshop?",{"start":55,"end":58},{"line":56,"column":14,"offset":57},10,508,{"line":56,"column":59,"offset":60},45,549,{"start":62,"end":64},{"line":56,"column":10,"offset":63},505,{"line":56,"column":59,"offset":60},{"type":35,"children":66,"position":102},[67,76,95],{"type":20,"value":68,"position":69},"To upload an addon to the workshop, you will have to use the Workshop Uploader. You can launch the Workshop Uploader from the SDK Launcher or directly from the Portal 2: Community Edition SDK tool on steam, and instructions on how to use the Uploader can be found on ",{"start":70,"end":73},{"line":71,"column":10,"offset":72},12,551,{"line":71,"column":74,"offset":75},268,818,{"type":77,"title":78,"url":79,"children":80,"position":90},"link",null,"/modding/workshop/workshopgui",[81],{"type":20,"value":82,"position":83},"This Page",{"start":84,"end":87},{"line":71,"column":85,"offset":86},269,819,{"line":71,"column":88,"offset":89},278,828,{"start":91,"end":92},{"line":71,"column":74,"offset":75},{"line":71,"column":93,"offset":94},310,860,{"type":20,"value":96,"position":97},".",{"start":98,"end":99},{"line":71,"column":93,"offset":94},{"line":71,"column":100,"offset":101},311,861,{"start":103,"end":104},{"line":71,"column":10,"offset":72},{"line":71,"column":100,"offset":101},{"type":17,"depth":50,"children":106,"position":116},[107],{"type":20,"value":108,"position":109},"How do I get my subscribed addons to work?",{"start":110,"end":113},{"line":111,"column":14,"offset":112},14,866,{"line":111,"column":114,"offset":115},46,908,{"start":117,"end":119},{"line":111,"column":10,"offset":118},863,{"line":111,"column":114,"offset":115},{"type":35,"children":121,"position":131},[122],{"type":20,"value":123,"position":124},"In the main menu, you will find a button labeled \"Addons\". Click on this, and you will get a list of all your installed addons. Check the boxes of the addons you want mounted, click apply, and now your addons are mounted to Portal 2: Community Edition. For now, maps can only be run through the console.",{"start":125,"end":128},{"line":126,"column":10,"offset":127},16,910,{"line":126,"column":129,"offset":130},304,1213,{"start":132,"end":133},{"line":126,"column":10,"offset":127},{"line":126,"column":129,"offset":130},{"start":135,"end":136},{"line":10,"column":10,"offset":11},{"line":137,"column":10,"offset":138},17,1214,{"title":140,"features":141,"type":143},"Workshop",[142],"USE_UGC","markdown","modding/workshop"],"uses":{"params":["category","article"]}}]}
