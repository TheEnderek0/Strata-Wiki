92,"meta":93},"p2ce-mod-template",{"title":94,"type":51},"P2:CE Mod Template",{"id":96,"meta":97},"vtf-v76",{"title":98,"type":51},"VTF v7.6 Format",[],{"id":101,"title":102,"weight":103,"type":51,"articles":104,"subtopics":132},"modding/util","Utilities",50,[105,108,111,114,117,120,123,126,129],{"id":106,"meta":107},"dmxconvert",{"title":106,"type":51},{"id":109,"meta":110},"kv3t",{"title":109,"type":51},{"id":112,"meta":113},"studiomdl",{"title":112,"type":51},{"id":115,"meta":116},"vbsp",{"title":115,"type":51},{"id":118,"meta":119},"vfont",{"title":118,"type":51},{"id":121,"meta":122},"vrad",{"title":121,"type":51},{"id":124,"meta":125},"vtex",{"title":124,"type":51},{"id":127,"meta":128},"vtex2",{"title":127,"type":51},{"id":130,"meta":131},"vvis",{"title":130,"type":51},[],{"id":134,"title":135,"type":51,"articles":136,"subtopics":146},"modding/workshop","Workshop",[137,141],{"id":138,"meta":139},"workshopoverview",{"title":135,"features":140,"type":51},[36],{"id":142,"meta":143},"workshopgui",{"title":144,"features":145,"type":51},"Workshop Uploader GUI",[36],[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":573,"topicID":578},false,{"type":3,"children":4,"position":570},"root",[5,16,34,50,66,95,112,126,141,154,169,183,198,212,227,241,256,323,344,369,382,415,429,444,458,472,487,503,518,544,557],{"type":6,"value":7,"position":8},"yaml","title: Workshop Uploader GUI\nfeatures:\n    - USE_UGC",{"start":9,"end":12},{"line":10,"column":10,"offset":11},1,0,{"line":13,"column":14,"offset":15},5,4,60,{"type":17,"depth":10,"children":18,"position":30},"heading",[19],{"type":20,"value":21,"position":22},"text","Workshop Uploader",{"start":23,"end":27},{"line":24,"column":25,"offset":26},7,3,64,{"line":24,"column":28,"offset":29},20,81,{"start":31,"end":33},{"line":24,"column":10,"offset":32},62,{"line":24,"column":28,"offset":29},{"type":35,"children":36,"position":47},"paragraph",[37],{"type":20,"value":38,"position":39},"The workshop uploader is a GUI frontend that can upload addons to the Steam workshop.\nAddons may contain maps, models, textures, materials and anything else that can be put in a normal Source Mod.",{"start":40,"end":43},{"line":41,"column":10,"offset":42},9,83,{"line":44,"column":45,"offset":46},10,111,279,{"start":48,"end":49},{"line":41,"column":10,"offset":42},{"line":44,"column":45,"offset":46},{"type":17,"depth":51,"children":52,"position":62},2,[53],{"type":20,"value":54,"position":55},"Setting up your Addon",{"start":56,"end":59},{"line":57,"column":14,"offset":58},12,284,{"line":57,"column":60,"offset":61},25,305,{"start":63,"end":65},{"line":57,"column":10,"offset":64},281,{"line":57,"column":60,"offset":61},{"type":35,"children":67,"position":92},[68,77,85],{"type":20,"value":69,"position":70},"Before uploading your addon, you must make sure all of your addon's assets (maps, materials, scripts, models, etc) are all in the right folders. Your Addon should be structured similar to a custom folder or sourcemod, with the root folder being your MOD folder and the subfolders being where your assets are located. It is usually the best practice to put your addon inside of ",{"start":71,"end":74},{"line":72,"column":10,"offset":73},13,306,{"line":72,"column":75,"offset":76},378,683,{"type":78,"value":79,"position":80},"inlineCode","p2ce\\addons",{"start":81,"end":82},{"line":72,"column":75,"offset":76},{"line":72,"column":83,"offset":84},391,696,{"type":20,"value":86,"position":87},", as the game can register your addon as a local addon and you can manage it like any other addon from the workshop inside of the game. Your folder setup should look similar to this:",{"start":88,"end":89},{"line":72,"column":83,"offset":84},{"line":72,"column":90,"offset":91},573,878,{"start":93,"end":94},{"line":72,"column":10,"offset":73},{"line":72,"column":90,"offset":91},{"type":35,"children":96,"position":109},[97],{"type":98,"title":99,"url":100,"alt":101,"position":102},"image",null,"images/addon_pre.png","Addon folder",{"start":103,"end":106},{"line":104,"column":10,"offset":105},15,880,{"line":104,"column":107,"offset":108},38,917,{"start":110,"end":111},{"line":104,"column":10,"offset":105},{"line":104,"column":107,"offset":108},{"type":35,"children":113,"position":123},[114],{"type":20,"value":115,"position":116},"Now, we can proceed with making this an actual addon.",{"start":117,"end":120},{"line":118,"column":10,"offset":119},17,919,{"line":118,"column":121,"offset":122},54,972,{"start":124,"end":125},{"line":118,"column":10,"offset":119},{"line":118,"column":121,"offset":122},{"type":17,"depth":51,"children":127,"position":137},[128],{"type":20,"value":129,"position":130},"How to use the Workshop Uploader",{"start":131,"end":134},{"line":132,"column":14,"offset":133},19,977,{"line":132,"column":135,"offset":136},36,1009,{"start":138,"end":140},{"line":132,"column":10,"offset":139},974,{"line":132,"column":135,"offset":136},{"type":35,"children":142,"position":151},[143],{"type":20,"value":144,"position":145},"The first step of using the Workshop Uploader is to launch it. You can find the Workshop Uploader by launching the SDK Launcher, then double-clicking the \"Workshop Uploader\" button under the \"tools\" heading.",{"start":146,"end":148},{"line":28,"column":10,"offset":147},1010,{"line":28,"column":149,"offset":150},208,1217,{"start":152,"end":153},{"line":28,"column":10,"offset":147},{"line":28,"column":149,"offset":150},{"type":35,"children":155,"position":166},[156],{"type":98,"title":99,"url":157,"alt":158,"position":159},"images/SDK_Launcher.png","SDK Launcher",{"start":160,"end":163},{"line":161,"column":10,"offset":162},22,1219,{"line":161,"column":164,"offset":165},41,1259,{"start":167,"end":168},{"line":161,"column":10,"offset":162},{"line":161,"column":164,"offset":165},{"type":35,"children":170,"position":180},[171],{"type":20,"value":172,"position":173},"Now that you have opened the sdk launcher, you will get this screen:",{"start":174,"end":177},{"line":175,"column":10,"offset":176},24,1261,{"line":175,"column":178,"offset":179},69,1329,{"start":181,"end":182},{"line":175,"column":10,"offset":176},{"line":175,"column":178,"offset":179},{"type":35,"children":184,"position":195},[185],{"type":98,"title":99,"url":186,"alt":187,"position":188},"images/workshop_gui_blank.png","Blank Workshop GUI",{"start":189,"end":192},{"line":190,"column":10,"offset":191},26,1331,{"line":190,"column":193,"offset":194},53,1383,{"start":196,"end":197},{"line":190,"column":10,"offset":191},{"line":190,"column":193,"offset":194},{"type":35,"children":199,"position":209},[200],{"type":20,"value":201,"position":202},"This is the Workshop Uploader GUI, where you will be able to manage most of how your addon will be uploaded to the workshop. From here, you can adjust the title, tags, description, and thumbnail of your addon. Here is an example of a fully filled out addon:",{"start":203,"end":206},{"line":204,"column":10,"offset":205},28,1385,{"line":204,"column":207,"offset":208},258,1642,{"start":210,"end":211},{"line":204,"column":10,"offset":205},{"line":204,"column":207,"offset":208},{"type":35,"children":213,"position":224},[214],{"type":98,"title":99,"url":215,"alt":216,"position":217},"images/workshop_gui_filled.png","Filled WOrkshop GUI",{"start":218,"end":221},{"line":219,"column":10,"offset":220},30,1644,{"line":219,"column":222,"offset":223},55,1698,{"start":225,"end":226},{"line":219,"column":10,"offset":220},{"line":219,"column":222,"offset":223},{"type":35,"children":228,"position":238},[229],{"type":20,"value":230,"position":231},"Now, if you re-examine your addon folder, you should see some new files that have been added:",{"start":232,"end":235},{"line":233,"column":10,"offset":234},32,1700,{"line":233,"column":236,"offset":237},94,1793,{"start":239,"end":240},{"line":233,"column":10,"offset":234},{"line":233,"column":236,"offset":237},{"type":35,"children":242,"position":253},[243],{"type":98,"title":99,"url":244,"alt":245,"position":246},"images/addon_post.png","Addon Folder w/ New items",{"start":247,"end":250},{"line":248,"column":10,"offset":249},34,1795,{"line":248,"column":251,"offset":252},52,1846,{"start":254,"end":255},{"line":248,"column":10,"offset":249},{"line":248,"column":251,"offset":252},{"type":35,"children":257,"position":320},[258,265,272,279,286,293,299,306,313],{"type":20,"value":259,"position":260},"Now, you will see a folder named ",{"start":261,"end":263},{"line":135,"column":10,"offset":262},1848,{"line":135,"column":248,"offset":264},1881,{"type":78,"value":266,"position":267},".assets",{"start":268,"end":269},{"line":135,"column":248,"offset":264},{"line":135,"column":270,"offset":271},43,1890,{"type":20,"value":273,"position":274}," and a file named ",{"start":275,"end":276},{"line":135,"column":270,"offset":271},{"line":135,"column":277,"offset":278},61,1908,{"type":78,"value":280,"position":281},"addon.kv3",{"start":282,"end":283},{"line":135,"column":277,"offset":278},{"line":135,"column":284,"offset":285},72,1919,{"type":20,"value":287,"position":288},". You can imagine ",{"start":289,"end":290},{"line":135,"column":284,"offset":285},{"line":135,"column":291,"offset":292},90,1937,{"type":78,"value":280,"position":294},{"start":295,"end":296},{"line":135,"column":291,"offset":292},{"line":135,"column":297,"offset":298},101,1948,{"type":20,"value":300,"position":301}," to be the ",{"start":302,"end":303},{"line":135,"column":297,"offset":298},{"line":135,"column":304,"offset":305},112,1959,{"type":78,"value":307,"position":308},"gameinfo.txt",{"start":309,"end":310},{"line":135,"column":304,"offset":305},{"line":135,"column":311,"offset":312},126,1973,{"type":20,"value":314,"position":315}," of your addon, holding all the various information about your addon, including its name, the workshop ID, its thumbnail, tags, etc. You should never have to manually edit this file, as you can edit most of its properties from the Uploader.",{"start":316,"end":317},{"line":135,"column":311,"offset":312},{"line":135,"column":318,"offset":319},366,2213,{"start":321,"end":322},{"line":135,"column":10,"offset":262},{"line":135,"column":318,"offset":319},{"type":324,"children":325,"position":340},"blockquote",[326],{"type":35,"children":327,"position":337},[328],{"type":20,"value":329,"position":330},"[!CAUTION]\nIf you choose to manually edit this file, you run the risk of breaking your addon! The format for this file is very specific, and if it is not met exactly, it could prevent your addon from being uploaded. Proceed with caution when manually editing this.",{"start":331,"end":333},{"line":107,"column":25,"offset":332},2217,{"line":334,"column":335,"offset":336},39,256,2483,{"start":338,"end":339},{"line":107,"column":25,"offset":332},{"line":334,"column":335,"offset":336},{"start":341,"end":343},{"line":107,"column":10,"offset":342},2215,{"line":334,"column":335,"offset":336},{"type":35,"children":345,"position":366},[346,353,359],{"type":20,"value":347,"position":348},"You will also find a ",{"start":349,"end":351},{"line":164,"column":10,"offset":350},2485,{"line":164,"column":161,"offset":352},2506,{"type":78,"value":266,"position":354},{"start":355,"end":356},{"line":164,"column":161,"offset":352},{"line":164,"column":357,"offset":358},31,2515,{"type":20,"value":360,"position":361}," folder if you chose a thumbnail for your mod, which will contain your thumbnail image. You shouldn't need to mess with this folder either, unless you want to change your thumbnail in the future.",{"start":362,"end":363},{"line":164,"column":357,"offset":358},{"line":164,"column":364,"offset":365},226,2710,{"start":367,"end":368},{"line":164,"column":10,"offset":350},{"line":164,"column":364,"offset":365},{"type":35,"children":370,"position":379},[371],{"type":20,"value":372,"position":373},"From here, click \"Save\" at the bottom of your addon. Now, launch Portal 2: Community Edition so you can test your addon before publishing it.",{"start":374,"end":376},{"line":270,"column":10,"offset":375},2712,{"line":270,"column":377,"offset":378},142,2853,{"start":380,"end":381},{"line":270,"column":10,"offset":375},{"line":270,"column":377,"offset":378},{"type":324,"children":383,"position":411},[384],{"type":35,"children":385,"position":408},[386,395,401],{"type":20,"value":387,"position":388},"[!TIP]\nDisable your custom folder and ",{"start":389,"end":392},{"line":390,"column":25,"offset":391},45,2857,{"line":393,"column":248,"offset":394},46,2897,{"type":78,"value":396,"position":397},"mounts.kv",{"start":398,"end":399},{"line":393,"column":248,"offset":394},{"line":393,"column":390,"offset":400},2908,{"type":20,"value":402,"position":403}," file before opening the game, that way you can see if you properly packed all the necessary materials and models!",{"start":404,"end":405},{"line":393,"column":390,"offset":400},{"line":393,"column":406,"offset":407},159,3022,{"start":409,"end":410},{"line":390,"column":25,"offset":391},{"line":393,"column":406,"offset":407},{"start":412,"end":414},{"line":390,"column":10,"offset":413},2855,{"line":393,"column":406,"offset":407},{"type":35,"children":416,"position":426},[417],{"type":20,"value":418,"position":419},"After you have fully tested your addon to make sure all necesary components are there, open back up the uploader, reopen your addon if you closed out of it, then click \"Upload\". After your addon gets fully packed, it will show you a popup with the URL to your uploaded mod. Now, click the \"View on Workshop\" button to open the page for your addon in your default browser. Don't worry if you do not have all the info you would like on your page, it automatically is marked as \"Hidden\", so only you can see it!",{"start":420,"end":423},{"line":421,"column":10,"offset":422},48,3024,{"line":421,"column":424,"offset":425},509,3532,{"start":427,"end":428},{"line":421,"column":10,"offset":422},{"line":421,"column":424,"offset":425},{"type":17,"depth":51,"children":430,"position":440},[431],{"type":20,"value":432,"position":433},"Adjusting your addon from the workshop page",{"start":434,"end":437},{"line":435,"column":14,"offset":436},50,3537,{"line":435,"column":438,"offset":439},47,3580,{"start":441,"end":443},{"line":435,"column":10,"offset":442},3534,{"line":435,"column":438,"offset":439},{"type":35,"children":445,"position":455},[446],{"type":20,"value":447,"position":448},"From here, you can adjust the various aspects of your mod, including additional pictures, videos, contributers, etc. Here is an example of a barebones workshop page:",{"start":449,"end":452},{"line":450,"column":10,"offset":451},51,3581,{"line":450,"column":453,"offset":454},166,3746,{"start":456,"end":457},{"line":450,"column":10,"offset":451},{"line":450,"column":453,"offset":454},{"type":35,"children":459,"position":469},[460],{"type":98,"title":99,"url":461,"alt":462,"position":463},"images/workshop_page_bare.png","Barebones Workshop page",{"start":464,"end":466},{"line":193,"column":10,"offset":465},3748,{"line":193,"column":467,"offset":468},58,3805,{"start":470,"end":471},{"line":193,"column":10,"offset":465},{"line":193,"column":467,"offset":468},{"type":35,"children":473,"position":482},[474],{"type":20,"value":475,"position":476},"Adjust your addon using the various options underneath the \"Owner Controls\" menu. After you have finished perfecting your addon's appearence, click on the \"Change visiblity\" dropdown and change it from \"Hidden\" to \"Public\".",{"start":477,"end":479},{"line":222,"column":10,"offset":478},3807,{"line":222,"column":480,"offset":481},224,4030,{"start":483,"end":484},{"line":222,"column":10,"offset":478},{"line":222,"column":485,"offset":486},225,4031,{"type":35,"children":488,"position":498},[489],{"type":20,"value":490,"position":491},"Congratulations! You have now successfully uploaded your addon to the Portal 2: Community Edition workshop!",{"start":492,"end":495},{"line":493,"column":10,"offset":494},57,4033,{"line":493,"column":496,"offset":497},108,4140,{"start":499,"end":500},{"line":493,"column":10,"offset":494},{"line":493,"column":501,"offset":502},109,4141,{"type":17,"depth":51,"children":504,"position":514},[505],{"type":20,"value":506,"position":507},"Updating your addon",{"start":508,"end":511},{"line":509,"column":14,"offset":510},59,4146,{"line":509,"column":512,"offset":513},23,4165,{"start":515,"end":517},{"line":509,"column":10,"offset":516},4143,{"line":509,"column":512,"offset":513},{"type":35,"children":519,"position":541},[520,528,534],{"type":20,"value":521,"position":522},"Updating an addon is as simple as uploading it. Add the new files to the addon folder and then reopen your addon in the Uploader. If you get a message saying that ",{"start":523,"end":525},{"line":15,"column":10,"offset":524},4166,{"line":15,"column":526,"offset":527},164,4329,{"type":78,"value":280,"position":529},{"start":530,"end":531},{"line":15,"column":526,"offset":527},{"line":15,"column":532,"offset":533},175,4340,{"type":20,"value":535,"position":536}," has been changed, accept the popup and move on. Now, make any additional changes to your addon, and click \"Upload\". You will get a popup asking you for an update message that looks like this:",{"start":537,"end":538},{"line":15,"column":532,"offset":533},{"line":15,"column":539,"offset":540},367,4532,{"start":542,"end":543},{"line":15,"column":10,"offset":524},{"line":15,"column":539,"offset":540},{"type":35,"children":545,"position":554},[546],{"type":98,"title":99,"url":547,"alt":548,"position":549},"images/update_popup.png","Update Popup",{"start":550,"end":552},{"line":32,"column":10,"offset":551},4534,{"line":32,"column":164,"offset":553},4574,{"start":555,"end":556},{"line":32,"column":10,"offset":551},{"line":32,"column":164,"offset":553},{"type":35,"children":558,"position":567},[559],{"type":20,"value":560,"position":561},"Add any message you want, and then click Ok. Now, your addon will be updated!",{"start":562,"end":564},{"line":26,"column":10,"offset":563},4576,{"line":26,"column":565,"offset":566},78,4653,{"start":568,"end":569},{"line":26,"column":10,"offset":563},{"line":26,"column":565,"offset":566},{"start":571,"end":572},{"line":10,"column":10,"offset":11},{"line":26,"column":565,"offset":566},{"title":574,"features":575,"type":577},"Workshop Uploader GUI",[576],"USE_UGC","markdown","modding/workshop"],"uses":{"params":["category","article"]}}]}
