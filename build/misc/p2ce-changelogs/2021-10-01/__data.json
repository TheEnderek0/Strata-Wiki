"end":76},{"line":67,"column":13,"offset":75},61,{"line":67,"column":77,"offset":78},37,97,{"type":9,"value":80,"position":81},"\r\nThis will allow us to rapidly iterate on the UI and port hammer to other platforms, like Linux. Additionally, Hammer will finally have proper theming, text anti-aliasing and hi-dpi support.\r\nThe upgrade will be incremental- right now only the \"run map normal\", \"about\" and some file open dialogs use Qt, the rest are still MFC or VGUI. As time goes on, more and more of the UI will be replaced with Qt.\r\nIf you value hammer stability, ",{"start":82,"end":83},{"line":67,"column":77,"offset":78},{"line":84,"column":85,"offset":86},7,32,536,{"type":19,"children":88,"position":98},[89],{"type":9,"value":90,"position":91},"please",{"start":92,"end":95},{"line":84,"column":93,"offset":94},34,538,{"line":84,"column":96,"offset":97},40,544,{"start":99,"end":100},{"line":84,"column":85,"offset":86},{"line":84,"column":101,"offset":102},42,546,{"type":9,"value":104,"position":105}," use an old branch of P2CE. There will be bugs during the porting process, but it's a necessary step to take.",{"start":106,"end":107},{"line":84,"column":101,"offset":102},{"line":84,"column":108,"offset":109},151,655,{"start":111,"end":112},{"line":67,"column":13,"offset":75},{"line":84,"column":113,"offset":114},152,656,{"type":6,"children":116,"position":149},[117,126,142],{"type":9,"value":118,"position":119},"A note for windows 7 and 8 users: Keep in mind that the end is near! We're using Qt 6.2.0 right now, which ",{"start":120,"end":123},{"line":121,"column":13,"offset":122},9,660,{"line":121,"column":124,"offset":125},108,767,{"type":43,"children":127,"position":137},[128],{"type":9,"value":129,"position":130},"does not officially support old versions of windows",{"start":131,"end":134},{"line":121,"column":132,"offset":133},109,768,{"line":121,"column":135,"offset":136},160,819,{"start":138,"end":139},{"line":121,"column":124,"offset":125},{"line":121,"co