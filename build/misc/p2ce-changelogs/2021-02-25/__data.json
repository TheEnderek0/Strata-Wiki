"type":51},{"id":188,"meta":189},"2021-05-27",{"title":188,"type":51},{"id":191,"meta":192},"2021-05-04",{"title":191,"type":51},{"id":194,"meta":195},"2021-02-25",{"title":194,"type":51},{"id":197,"meta":198},"2020-11-13",{"title":197,"type":51},{"id":200,"meta":201},"2020-10-18",{"title":200,"type":51},{"id":203,"meta":204},"2020-10-10",{"title":203,"type":51},{"id":206,"meta":207},"2020-09-08",{"title":206,"type":51},[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":238,"topicID":241},false,{"type":3,"children":4,"position":235},"root",[5,31,44,66,78,106,114,136,145,167,176,197,205,226],{"type":6,"children":7,"position":28},"paragraph",[8],{"type":9,"children":10,"position":22},"strong",[11],{"type":12,"value":13,"position":14},"text","0.5.5 has been released!",{"start":15,"end":19},{"line":16,"column":17,"offset":18},1,3,2,{"line":16,"column":20,"offset":21},27,26,{"start":23,"end":25},{"line":16,"column":16,"offset":24},0,{"line":16,"column":26,"offset":27},29,28,{"start":29,"end":30},{"line":16,"column":16,"offset":24},{"line":16,"column":26,"offset":27},{"type":6,"children":32,"position":41},[33],{"type":12,"value":34,"position":35},"This is a big one.",{"start":36,"end":38},{"line":17,"column":16,"offset":37},32,{"line":17,"column":39,"offset":40},19,50,{"start":42,"end":43},{"line":17,"column":16,"offset":37},{"line":17,"column":39,"offset":40},{"type":6,"children":45,"position":63},[46],{"type":9,"children":47,"position":57},[48],{"type":12,"value":49,"position":50},"Hammer",{"start":51,"end":54},{"line":52,"column":17,"offset":53},5,56,{"line":52,"column":55,"offset":56},9,62,{"start":58,"end":60},{"line":52,"column":16,"offset":59},54,{"line":52,"column":61,"offset":62},11,64,{"start":64,"end":65},{"line":52,"column":16,"offset":59},{"line":52,"column":61,"offset":62},{"type":67,"lang":68,"meta":68,"value":69,"position":70},"code",null,"* Added \"3D Portalable Viewport\"\r\n* Added filter to sequences tab in model browser\r\n* Improved filtering for all filter text-boxes (Now supports wildcard * and is space separated)\r\n* Added ability to set a model's animation from the model browser as the prop's default animation\r\n* Added setting to General Options to enable / disable whether or not empty visgroups should automatically be deleted\r\n* Added setting to General Options to enable / disable a warning that pops up when carving with a brush of more than 6 sides\r\n* Added button to visgroups editor to delete all empty visgroups manually\r\n* Added checkbox to disable VertexLitGeneric materials showing in texture browser\r\n\r\n* Fixed \"2D Logical\" background color bug\r\n* Fixed model browser not scrolling to the selected item\r\n* Fixed modelscale not rescaling the model in hammer\r\n\r\n* Model Browser and Particle Browser are now maximizable\r\n* Added new P2CE theme to Model Browser and Particle Browser\r\n* Moved \"Move Selected Objects to Visgroup\" option from View to Tools tab\r\n* Hammer now uses a better folder picker when picking folders",{"start":71,"end":74},{"line":72,"column":16,"offset":73},6,66,{"line":75,"column":76,"offset":77},24,4,1174,{"type":6,"children":79,"position":103},[80,96],{"type":9,"children":81,"position":90},[82],{"type":12,"value":83,"position":84},"Changes ported from Momentum's Hammer",{"start":85,"end":87},{"line":21,"column":17,"offset":86},1180,{"line":21,"column":88,"offset":89},40,1217,{"start":91,"end":93},{"line":21,"column":16,"offset":92},1178,{"line":21,"column":94,"offset":95},42,1219,{"type":12,"value":97,"position":98},"\r\nWe ported everything, which is a lot. Here are the highlights:",{"start":99,"end":100},{"line":21,"column":94,"offset":95},{"line":20,"column":101,"offset":102},63,1283,{"start":104,"end":105},{"line":21,"column":16,"offset":92},{"line":20,"column":101,"offset":102},{"type":67,"lang":68,"meta":68,"value":107,"position":108},"* Added keybind editor\r\n* Added viewport color editor\r\n* Make Color-picker Keyvalue fields recolor its field with the selected color\r\n\r\n* Hammer now stores brush vertex coordinates in the vmf. This solves the floating point precision error for complex, off-grid brushes on repeating map-loads\r\n* Unknown textures now use the iconic purple/black checkerboard pattern in texture browser",{"start":109,"end":111},{"line":27,"column":16,"offset":110},1285,{"line":112,"column":76,"offset":113},35,1679,{"type":6,"children":115,"position":133},[116],{"type":9,"children":117,"position":127},[118],{"type":12,"value":119,"position":120},"Crosshair",{"start":121,"end":124},{"line":122,"column":17,"offset":123},37,1685,{"line":122,"column":125,"offset":126},12,1694,{"start":128,"end":130},{"line":122,"column":16,"offset":129},1683,{"line":122,"column":131,"offset":132},14,1696,{"start":134,"end":135},{"line":122,"column":16,"offset":129},{"line":122,"column":131,"offset":132},{"type":67,"lang":68,"meta":68,"value":137,"position":138},"* Added cvar portalgun_crosshair_mode. 0 = Portal 2 mode | 1 = Portal 1 mode\r\n* Fixed Portal 2's crosshair being always filled when holding the single-portal-gun",{"start":139,"end":142},{"line":140,"column":16,"offset":141},38,1698,{"line":143,"column":76,"offset":144},41,1869,{"type":6,"children":146,"position":164},[147],{"type":9,"children":148,"position":158},[149],{"type":12,"value":150,"position":151},"vgui_movie_display",{"start":152,"end":155},{"line":153,"column":17,"offset":154},43,1875,{"line":153,"column":156,"offset":157},21,1893,{"start":159,"end":161},{"line":153,"column":16,"offset":160},1873,{"line":153,"column":162,"offset":163},23,1895,{"start":165,"end":166},{"line":153,"column":16,"offset":160},{"line":153,"column":162,"offset":163},{"type":67,"lang":68,"meta":68,"value":168,"position":169},"* Added keyvalue \"noscanline\" to disable the scanline overlay\r\n* Added keyvalues to set the UV min/max coordinates directly, instead of having to use inputs\r\n* Videos no longer restart when pausing the game\r\n* Videos can now play audio (The sound comes from everywhere and doesn't respect volume. This is an early implementation)",{"start":170,"end":173},{"line":171,"column":16,"offset":172},44,1897,{"line":174,"column":76,"offset":175},49,2236,{"type":6,"children":177,"position":194},[178],{"type":9,"children":179,"position":188},[180],{"type":12,"value":181,"position":182},"Panorama",{"start":183,"end":186},{"line":184,"column":17,"offset":185},51,2242,{"line":184,"column":61,"offset":187},2250,{"start":189,"end":191},{"line":184,"column":16,"offset":190},2240,{"line":184,"column":192,"offset":193},13,2252,{"start":195,"end":196},{"line":184,"column":16,"offset":190},{"line":184,"column":192,"offset":193},{"type":67,"lang":68,"meta":68,"value":198,"position":199},"* The engine is now able to load panorama code. There is no panorama UI yet, so the game will default to VGUI, but the functionality is there",{"start":200,"end":203},{"line":201,"column":16,"offset":202},52,2254,{"line":59,"column":76,"offset":204},2405,{"type":6,"children":206,"position":223},[207],{"type":9,"children":208,"position":217},[209],{"type":12,"value":210,"position":211},"Other",{"start":212,"end":214},{"line":53,"column":17,"offset":213},2411,{"line":53,"column":215,"offset":216},8,2416,{"start":218,"end":220},{"line":53,"column":16,"offset":219},2409,{"line":53,"column":221,"offset":222},10,2418,{"start":224,"end":225},{"line":53,"column":16,"offset":219},{"line":53,"column":221,"offset":222},{"type":67,"lang":68,"meta":68,"value":227,"position":228},"* Added -V parameter to vpk.exe to select which VPK version should be used\r\n* vpk.exe no longer strips _dir from single-chunk VPKs\r\n* The game now saves files into the modwrapper's directory instead of P2CE's\r\n* Added volumetric gaussian blur and downsample to alleviate jaggedness issue\r\n* Linux improvements and fixes\r\n* Added some Half-Life 2 compatibility\r\n* Much internal cleanup",{"start":229,"end":232},{"line":230,"column":16,"offset":231},57,2420,{"line":233,"column":76,"offset":234},65,2814,{"start":236,"end":237},{"line":16,"column":16,"offset":24},{"line":233,"column":76,"offset":234},{"title":239,"type":240},"2021-02-25","markdown","misc/p2ce-changelogs"],"uses":{"params":["category","article"]}}]}
