"type":51},{"id":188,"meta":189},"2021-05-27",{"title":188,"type":51},{"id":191,"meta":192},"2021-05-04",{"title":191,"type":51},{"id":194,"meta":195},"2021-02-25",{"title":194,"type":51},{"id":197,"meta":198},"2020-11-13",{"title":197,"type":51},{"id":200,"meta":201},"2020-10-18",{"title":200,"type":51},{"id":203,"meta":204},"2020-10-10",{"title":203,"type":51},{"id":206,"meta":207},"2020-09-08",{"title":206,"type":51},[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":209,"topicID":212},false,{"type":3,"children":4,"position":205},"root",[5,92,121],{"type":6,"children":7,"position":89},"paragraph",[8,28,36,52,59],{"type":9,"children":10,"position":22},"strong",[11],{"type":12,"value":13,"position":14},"text","LINUX USERS:",{"start":15,"end":19},{"line":16,"column":17,"offset":18},1,3,2,{"line":16,"column":20,"offset":21},15,14,{"start":23,"end":25},{"line":16,"column":16,"offset":24},0,{"line":16,"column":26,"offset":27},17,16,{"type":12,"value":29,"position":30},"\r\nYou will need a vulkan capable GPU starting now. 🦀 ToGL is gone forever 🦀\r\nWe've made sure to test P2CE on RADV (AMD's mesa vulkan drivers), ANV (Intel's mesa vulkan drivers) and on the proprietary Nvidia driver. I've confirmed that it works on my laptop with an intel HD 4000 iGPU and with a shitty $25 AMD gpu from 2015, so pretty much everyone's hardware should be supported.\r\nPlease note that AMDVLK has ",{"start":31,"end":32},{"line":16,"column":26,"offset":27},{"line":33,"column":34,"offset":35},4,29,430,{"type":9,"children":37,"position":47},[38],{"type":12,"value":39,"position":40},"NOT",{"start":41,"end":44},{"line":33,"column":42,"offset":43},31,432,{"line":33,"column":45,"offset":46},34,435,{"start":48,"end":49},{"line":33,"column":34,"offset":35},{"line":33,"column":50,"offset":51},36,437,{"type":12,"value":53,"position":54}," been tested, so it may not work.\r\n",{"start":55,"end":56},{"line":33,"column":50,"offset":51},{"line":57,"column":16,"offset":58},5,473,{"type":9,"children":60,"position":84},[61,69,77],{"type":12,"value":62,"position":63},"There's also a bug with RESZ depth resolve which can cause graphical glitches, setting ",{"start":64,"end":66},{"line":57,"column":17,"offset":65},475,{"line":57,"column":67,"offset":68},90,562,{"type":70,"value":71,"position":72},"inlineCode","mat_resolveFullFrameDepth",{"start":73,"end":74},{"line":57,"column":67,"offset":68},{"line":57,"column":75,"offset":76},117,589,{"type":12,"value":78,"position":79}," to 0 fixes these at a slight performance cost",{"start":80,"end":81},{"line":57,"column":75,"offset":76},{"line":57,"column":82,"offset":83},163,635,{"start":85,"end":86},{"line":57,"column":16,"offset":58},{"line":57,"column":87,"offset":88},165,637,{"start":90,"end":91},{"line":16,"column":16,"offset":24},{"line":57,"column":87,"offset":88},{"type":6,"children":93,"position":118},[94,110],{"type":9,"children":95,"position":104},[96],{"type":12,"value":97,"position":98},"WINDOWS USERS:",{"start":99,"end":102},{"line":100,"column":17,"offset":101},7,643,{"line":100,"column":26,"offset":103},657,{"start":105,"end":107},{"line":100,"column":16,"offset":106},641,{"line":100,"column":108,"offset":109},19,659,{"type":12,"value":111,"position":112},"\r\nWindows 7, 8 and 8.1 may not work properly! There's currently a bug on dx11 that breaks windows 7 support, a fix is pending for that.\r\nNobody on our team does testing on these older versions of windows, so things may break periodically. If we encounter an issue that is too difficult/time consuming to patch, we may end up dropping support for the old windows version it affects completely.\r\nThis isn't because we don't like windows 7, 8 or 8.1, it's because nobody on either P2CE's team or momentum's team is running them. There's also some difficulty with DX versions on Windows 7 specifically (such as dxgi 1.2 being the max dxgi version on 7)",{"start":113,"end":114},{"line":100,"column":108,"offset":109},{"line":115,"column":116,"offset":117},10,255,1308,{"start":119,"end":120},{"line":100,"column":16,"offset":106},{"line":115,"column":116,"offset":117},{"type":6,"children":122,"position":202},[123,139,146,153,160,167,174,181,188,195],{"type":9,"children":124,"position":134},[125],{"type":12,"value":126,"position":127},"Another note for linux users:",{"start":128,"end":131},{"line":129,"column":17,"offset":130},12,1314,{"line":129,"column":132,"offset":133},32,1343,{"start":135,"end":137},{"line":129,"column":16,"offset":136},1312,{"line":129,"column":45,"offset":138},1345,{"type":12,"value":140,"position":141},"\r\nIf you're running on AMD or Intel, make sure you have mesa and mesa's vulkan drivers installed!\r\nOn Arch the packages are called ",{"start":142,"end":143},{"line":129,"column":45,"offset":138},{"line":21,"column":144,"offset":145},33,1477,{"type":70,"value":147,"position":148},"mesa",{"start":149,"end":150},{"line":21,"column":144,"offset":145},{"line":21,"column":151,"offset":152},39,1483,{"type":12,"value":154,"position":155}," and ",{"start":156,"end":157},{"line":21,"column":151,"offset":152},{"line":21,"column":158,"offset":159},44,1488,{"type":70,"value":161,"position":162},"vulkan-radeon",{"start":163,"end":164},{"line":21,"column":158,"offset":159},{"line":21,"column":165,"offset":166},59,1503,{"type":12,"value":168,"position":169}," or ",{"start":170,"end":171},{"line":21,"column":165,"offset":166},{"line":21,"column":172,"offset":173},63,1507,{"type":70,"value":175,"position":176},"vulkan-intel",{"start":177,"end":178},{"line":21,"column":172,"offset":173},{"line":21,"column":179,"offset":180},77,1521,{"type":12,"value":182,"position":183}," (Make sure to install the correct one for your GPU)\r\nOn Debian-based distros the package is called ",{"start":184,"end":185},{"line":21,"column":179,"offset":180},{"line":20,"column":186,"offset":187},47,1621,{"type":70,"value":189,"position":190},"mesa-vulkan-drivers",{"start":191,"end":192},{"line":20,"column":186,"offset":187},{"line":20,"column":193,"offset":194},68,1642,{"type":12,"value":196,"position":197},"  (This should install mesa as well)",{"start":198,"end":199},{"line":20,"column":193,"offset":194},{"line":20,"column":200,"offset":201},104,1678,{"start":203,"end":204},{"line":129,"column":16,"offset":136},{"line":20,"column":200,"offset":201},{"start":206,"end":207},{"line":16,"column":16,"offset":24},{"line":27,"column":16,"offset":208},1680,{"title":210,"type":211},"2021-08-02","markdown","misc/p2ce-changelogs"],"uses":{"params":["category","article"]}}]}
