8,"position":331},[309,318,324],{"type":20,"value":310,"position":311},"Installing the types as a Git submodule is a similar process. The submodule can be initialized to the ",{"start":312,"end":315},{"line":313,"column":10,"offset":314},40,1508,{"line":313,"column":316,"offset":317},103,1610,{"type":236,"value":319,"position":320},"scripts/types",{"start":321,"end":322},{"line":313,"column":316,"offset":317},{"line":313,"column":269,"offset":323},1625,{"type":20,"value":325,"position":326}," folder via the following command:",{"start":327,"end":328},{"line":313,"column":269,"offset":323},{"line":313,"column":329,"offset":330},152,1659,{"start":332,"end":333},{"line":313,"column":10,"offset":314},{"line":313,"column":329,"offset":330},{"type":216,"lang":47,"meta":47,"value":335,"position":336},"git submodule add \"https://github.com/StrataSource/pano-typed.git\" scripts/types",{"start":337,"end":340},{"line":338,"column":10,"offset":339},42,1661,{"line":341,"column":14,"offset":342},44,1749,{"type":34,"children":344,"position":367},[345,354,360],{"type":20,"value":346,"position":347},"Just as the previous method, the location and subfolder of the types can be specified in the ",{"start":348,"end":351},{"line":349,"column":10,"offset":350},46,1751,{"line":349,"column":352,"offset":353},94,1844,{"type":236,"value":237,"position":355},{"start":356,"end":357},{"line":349,"column":352,"offset":353},{"line":349,"column":358,"offset":359},109,1859,{"type":20,"value":361,"position":362},".",{"start":363,"end":364},{"line":349,"column":358,"offset":359},{"line":349,"column":365,"offset":366},110,1860,{"start":368,"end":369},{"line":349,"column":10,"offset":350},{"line":349,"column":365,"offset":366},{"type":216,"lang":282,"meta":283,"value":371,"position":372},"{\n\t\"compilerOptions\": {\n\t\t\"typeRoots\": [\"./scripts/types\"],\n\t\t\"types\": [\"p2ce\"]\n\t}\n}",{"start":373,"end":375},{"line":182,"column":10,"offset":374},1862,{"line":376,"column":14,"offset":377},55,1975,{"type":17,"depth":68,"children":379,"position":389},[380],{"type":20,"value":381,"position":382},"External Transpilation",{"start":383,"end":386},{"line":384,"column":14,"offset":385},57,1980,{"line":384,"column":387,"offset":388},26,2002,{"start":390,"end":392},{"line":384,"column":10,"offset":391},1977,{"line":384,"column":387,"offset":388},{"type":34,"children":394,"position":444},[395,403,410,417,424,431,437],{"type":20,"value":396,"position":397},"When using Typescript, it is conventional to transpile it to JavaScript before passing it onto the target platform. While this is an option, Strata also supports directly importing and referencing TypeScript files. These files are internally transpiled and cached. This happens within the engine and is only recompiled whenever the code changes. To enable this functionality, simply use the ",{"start":398,"end":401},{"line":399,"column":10,"offset":400},59,2004,{"line":399,"column":109,"offset":402},2395,{"type":236,"value":404,"position":405},".ts",{"start":406,"end":407},{"line":399,"column":109,"offset":402},{"line":399,"column":408,"offset":409},397,2400,{"type":20,"value":411,"position":412}," extension in place of the ",{"start":413,"end":414},{"line":399,"column":408,"offset":409},{"line":399,"column":415,"offset":416},424,2427,{"type":236,"value":418,"position":419},".js",{"start":420,"end":421},{"line":399,"column":415,"offset":416},{"line":399,"column":422,"offset":423},429,2432,{"type":20,"value":425,"position":426}," extension on your files. Note that ",{"start":427,"end":428},{"line":399,"column":422,"offset":423},{"line":399,"column":429,"offset":430},465,2468,{"type":236,"value":404,"position":432},{"start":433,"end":434},{"line":399,"column":429,"offset":430},{"line":399,"column":435,"offset":436},470,2473,{"type":20,"value":438,"position":439}," extensions are also expected in module imports.",{"start":440,"end":441},{"line":399,"column":435,"offset":436},{"line":399,"column":442,"offset":443},518,2521,{"start":445,"end":446},{"line":399,"column":10,"offset":400},{"line":399,"column":442,"offset":443},{"type":448,"children":449,"position":477},"blockquote",[450],{"type":34,"children":451,"position":474},[452,460,467],{"type":20,"value":453,"position":454},"[!TIP]\nIf you find that your code is not updating correctly in-game, try closing the game and deleting the ",{"start":455,"end":457},{"line":100,"column":13,"offset":456},2525,{"line":458,"column":316,"offset":459},62,2634,{"type":236,"value":461,"position":462},"panorama_cache.dat",{"start":463,"end":464},{"line":458,"column":316,"offset":459},{"line":458,"column":465,"offset":466},123,2654,{"type":20,"value":468,"position":469}," file. This fully removes any cached transpiled TypeScript/SCSS code.",{"start":470,"end":471},{"line":458,"column":465,"offset":466},{"line":458,"column":472,"offset":473},192,2723,{"start":475,"end":476},{"line":100,"column":13,"offset":456},{"line":458,"column":472,"offset":473},{"start":478,"end":480},{"line":100,"column":10,"offset":479},2523,{"line":458,"column":472,"offset":473},{"type":34,"children":482,"position":491},[483],{"type":20,"value":484,"position":485},"During development, as well as for projects which encourage users to customize the interface, it is recommended to ship TypeScript instead of passing it through a bundler. It is for this reason that both Momentum Mod and Portal 2: Community Edition ship their TypeScript code. For other mods and games, using pre-transpiled scripts may net a slight performance benefit.",{"start":486,"end":489},{"line":487,"column":10,"offset":488},64,2725,{"line":487,"column":104,"offset":490},3094,{"start":492,"end":493},{"line":487,"column":10,"offset":488},{"line":487,"column":104,"offset":490},{"type":34,"children":495,"position":505},[496],{"type":20,"value":497,"position":498},"It is recommended to use the TypeScript transpiler without any additional bundling, as a bundler will have to be configured to treat each file referenced by a panel as an individual entrypoint, saving minimal amounts of storage (possibly increasing it when using shared modules!) and increasing deployment complexity unnecessarily.",{"start":499,"end":502},{"line":500,"column":10,"offset":501},66,3096,{"line":500,"column":503,"offset":504},332,3427,{"start":506,"end":507},{"line":500,"column":10,"offset":501},{"line":500,"column":503,"offset":504},{"start":509,"end":510},{"line":10,"column":10,"offset":11},{"line":103,"column":10,"offset":511},3428,{"title":21,"type":513},"markdown","panorama/scripting"],"uses":{"params":["category","article"]}}]}
