93,"meta":394},"Style",{"type":110,"title":393,"disablePageActions":117,"features":395},[],[]],"uses":{"params":["category"]}},null,{"type":"data","data":[{"isTopic":1,"doc":2,"articleMeta":549,"topicID":551},false,{"type":3,"children":4,"position":544},"root",[5,15,33,48,62,84,133,149,177,189,230,240,267,276,290,304,319,333,360,370,380,394,402,411,426,453,464,479],{"type":6,"value":7,"position":8},"yaml","title: Using Modules\nweight: 0",{"start":9,"end":12},{"line":10,"column":10,"offset":11},1,0,{"line":13,"column":13,"offset":14},4,38,{"type":16,"depth":10,"children":17,"position":29},"heading",[18],{"type":19,"value":20,"position":21},"text","Using Modules",{"start":22,"end":26},{"line":23,"column":24,"offset":25},6,3,42,{"line":23,"column":27,"offset":28},16,55,{"start":30,"end":32},{"line":23,"column":10,"offset":31},40,{"line":23,"column":27,"offset":28},{"type":34,"children":35,"position":45},"paragraph",[36],{"type":19,"value":37,"position":38},"Strata Source Panorama supports a subset of the ECMAScript modules specification. This can be used to create cleaner and more modular code by reusing script exports without introducing clutter into the panel scope.",{"start":39,"end":42},{"line":40,"column":10,"offset":41},8,57,{"line":40,"column":43,"offset":44},215,271,{"start":46,"end":47},{"line":40,"column":10,"offset":41},{"line":40,"column":43,"offset":44},{"type":34,"children":49,"position":59},[50],{"type":19,"value":51,"position":52},"Just as non-module code is treated, script modules are reimported with a fresh instance for each panel. If a single module is used between multiple panels, each panel will get its own instance. If multiple scripts in a single panel reuse the same import, they will share the same instance.",{"start":53,"end":56},{"line":54,"column":10,"offset":55},10,273,{"line":54,"column":57,"offset":58},290,562,{"start":60,"end":61},{"line":54,"column":10,"offset":55},{"line":54,"column":57,"offset":58},{"type":63,"children":64,"position":80},"blockquote",[65],{"type":34,"children":66,"position":77},[67],{"type":19,"value":68,"position":69},"[!NOTE]\nDynamic imports, import.meta, and top-level awaits are unsupported.",{"start":70,"end":73},{"line":71,"column":24,"offset":72},12,566,{"line":74,"column":75,"offset":76},13,70,643,{"start":78,"end":79},{"line":71,"column":24,"offset":72},{"line":74,"column":75,"offset":76},{"start":81,"end":83},{"line":71,"column":10,"offset":82},564,{"line":74,"column":75,"offset":76},{"type":63,"children":85,"position":129},[86],{"type":34,"children":87,"position":126},[88,97,105,112,119],{"type":19,"value":89,"position":90},"[!NOTE]\nAll of the below works as expected with Typescript. Substituting the ",{"start":91,"end":94},{"line":92,"column":24,"offset":93},15,647,{"line":27,"column":95,"offset":96},72,726,{"type":98,"value":99,"position":100},"inlineCode",".js",{"start":101,"end":102},{"line":27,"column":95,"offset":96},{"line":27,"column":103,"offset":104},77,731,{"type":19,"value":106,"position":107}," extensions with ",{"start":108,"end":109},{"line":27,"column":103,"offset":104},{"line":27,"column":110,"offset":111},94,748,{"type":98,"value":113,"position":114},".ts",{"start":115,"end":116},{"line":27,"column":110,"offset":111},{"line":27,"column":117,"offset":118},99,753,{"type":19,"value":120,"position":121}," will cause the code to be transpiled and cached by the engine prior to execution.",{"start":122,"end":123},{"line":27,"column":117,"offset":118},{"line":27,"column":124,"offset":125},181,835,{"start":127,"end":128},{"line":92,"column":24,"offset":93},{"line":27,"column":124,"offset":125},{"start":130,"end":132},{"line":92,"column":10,"offset":131},645,{"line":27,"column":124,"offset":125},{"type":16,"depth":134,"children":135,"position":145},2,[136],{"type":19,"value":137,"position":138},"Example",{"start":139,"end":142},{"line":140,"column":13,"offset":141},18,840,{"line":140,"column":143,"offset":144},11,847,{"start":146,"end":148},{"line":140,"column":10,"offset":147},837,{"line":140,"column":143,"offset":144},{"type":34,"children":150,"position":174},[151,160,167],{"type":19,"value":152,"position":153},"To expose a function or variable, the ",{"start":154,"end":157},{"line":155,"column":10,"offset":156},20,849,{"line":155,"column":158,"offset":159},39,887,{"type":98,"value":161,"position":162},"export",{"start":163,"end":164},{"line":155,"column":158,"offset":159},{"line":155,"column":165,"offset":166},47,895,{"type":19,"value":168,"position":169}," syntax can be used.",{"start":170,"end":171},{"line":155,"column":165,"offset":166},{"line":155,"column":172,"offset":173},67,915,{"start":175,"end":176},{"line":155,"column":10,"offset":156},{"line":155,"column":172,"offset":173},{"type":178,"lang":179,"meta":180,"value":181,"position":182},"code","js",":: scripts/utils/math.js","export function square(x) {\n\treturn x ** 2;\n}",{"start":183,"end":186},{"line":184,"column":10,"offset":185},22,917,{"line":187,"column":13,"offset":188},26,997,{"type":34,"children":190,"position":227},[191,199,206,213,220],{"type":19,"value":192,"position":193},"To use these exported properties, an import can be declared with the ",{"start":194,"end":197},{"line":195,"column":10,"offset":196},28,999,{"line":195,"column":75,"offset":198},1068,{"type":98,"value":200,"position":201},"import",{"start":202,"end":203},{"line":195,"column":75,"offset":198},{"line":195,"column":204,"offset":205},78,1076,{"type":19,"value":207,"position":208}," syntax. Absolute paths will be resolved relative to the ",{"start":209,"end":210},{"line":195,"column":204,"offset":205},{"line":195,"column":211,"offset":212},135,1133,{"type":98,"value":214,"position":215},"scripts/",{"start":216,"end":217},{"line":195,"column":211,"offset":212},{"line":195,"column":218,"offset":219},145,1143,{"type":19,"value":221,"position":222}," directory, and relative import paths will be resolved relative to the current file.",{"start":223,"end":224},{"line":195,"column":218,"offset":219},{"line":195,"column":225,"offset":226},229,1227,{"start":228,"end":229},{"line":195,"column":10,"offset":196},{"line":195,"column":225,"offset":226},{"type":178,"lang":179,"meta":231,"value":232,"position":233},":: scripts/utils/saysquare.js","import { square } from './math.js';\n\nexport function saySquare(x) {\n\t$.Msg(`The square of ${x} is ${square(x)}!`);\n}",{"start":234,"end":237},{"line":235,"column":10,"offset":236},30,1229,{"line":238,"column":13,"offset":239},36,1385,{"type":34,"children":241,"position":264},[242,250,257],{"type":19,"value":243,"position":244},"Similarly to how modules are declared on the web, scripts should be imported with ",{"start":245,"end":247},{"line":14,"column":10,"offset":246},1387,{"line":14,"column":248,"offset":249},83,1469,{"type":98,"value":251,"position":252},"type=\"module\"",{"start":253,"end":254},{"line":14,"column":248,"offset":249},{"line":14,"column":255,"offset":256},98,1484,{"type":19,"value":258,"position":259}," in the xml to inform the engine that it should be parsed as a module.",{"start":260,"end":261},{"line":14,"column":255,"offset":256},{"line":14,"column":262,"offset":263},168,1554,{"start":265,"end":266},{"line":14,"column":10,"offset":246},{"line":14,"column":262,"offset":263},{"type":178,"lang":268,"meta":269,"value":270,"position":271},"xml",null,"\u003Cinclude type=\"module\" src=\"file://{scripts}/utils/saysquare.js\" />",{"start":272,"end":274},{"line":31,"column":10,"offset":273},1556,{"line":25,"column":13,"offset":275},1634,{"type":34,"children":277,"position":287},[278],{"type":19,"value":279,"position":280},"Unfortunately, this example currently does nothing. Despite declaring and exporting our function, we don't have a way to attach the function to an event handler yet.",{"start":281,"end":284},{"line":282,"column":10,"offset":283},44,1636,{"line":282,"column":285,"offset":286},166,1801,{"start":288,"end":289},{"line":282,"column":10,"offset":283},{"line":282,"column":285,"offset":286},{"type":34,"children":291,"position":301},[292],{"type":19,"value":293,"position":294},"There are multiple ways of connecting the panel and script(s) - so we'll look at the simplest.",{"start":295,"end":298},{"line":296,"column":10,"offset":297},46,1803,{"line":296,"column":299,"offset":300},95,1897,{"start":302,"end":303},{"line":296,"column":10,"offset":297},{"line":296,"column":299,"offset":300},{"type":16,"depth":134,"children":305,"position":315},[306],{"type":19,"value":307,"position":308},"Basic Panel interactivity",{"start":309,"end":312},{"line":310,"column":13,"offset":311},48,1902,{"line":310,"column":313,"offset":314},29,1927,{"start":316,"end":318},{"line":310,"column":10,"offset":317},1899,{"line":310,"column":313,"offset":314},{"type":34,"children":320,"position":330},[321],{"type":19,"value":322,"position":323},"When declaring scripts as modules, variables are no longer implicitly exposed to the panel scope. Any variables that panels should interact with must be exposed by setting it as a property on the context object.",{"start":324,"end":327},{"line":325,"column":10,"offset":326},50,1929,{"line":325,"column":328,"offset":329},212,2140,{"start":331,"end":332},{"line":325,"column":10,"offset":326},{"line":325,"column":328,"offset":329},{"type":34,"children":334,"position":357},[335,344,350],{"type":19,"value":336,"position":337},"The context object is used as the script context when evaluating code that is embedded in panel tags in the xml, and is accessible through the ",{"start":338,"end":341},{"line":339,"column":10,"offset":340},52,2142,{"line":339,"column":342,"offset":343},144,2285,{"type":98,"value":345,"position":346},"$.GetContextObject()",{"start":347,"end":348},{"line":339,"column":342,"offset":343},{"line":339,"column":285,"offset":349},2307,{"type":19,"value":351,"position":352}," method.",{"start":353,"end":354},{"line":339,"column":285,"offset":349},{"line":339,"column":355,"offset":356},174,2315,{"start":358,"end":359},{"line":339,"column":10,"offset":340},{"line":339,"column":355,"offset":356},{"type":178,"lang":179,"meta":361,"value":362,"position":363},":: scripts/components/mypanel.js","import { saySquare } from 'utils/saysquare.js';\n\nconst context = $.GetContextObject();\n\ncontext.sayHelloAndSquare = function() {\n\t$.Msg('Hello!');\n\tsaySquare(5);\n}",{"start":364,"end":367},{"line":365,"column":10,"offset":366},54,2317,{"line":368,"column":13,"offset":369},63,2523,{"type":178,"lang":268,"meta":371,"value":372,"position":373},":: layout/components/mypanel.xml","\u003Croot>\n\t\u003Cscripts>\n\t\t\u003Cinclude type=\"module\" src=\"file://{scripts}/components/mypanel.js\" />\n\t\u003C/scripts>\n\t\u003CPanel>\n\t\t\u003CTextButton text=\"Test Button\" onactivate=\"sayHelloAndSquare()\" />\n\t\u003C/Panel>\n\u003C/root>",{"start":374,"end":377},{"line":375,"column":10,"offset":376},65,2525,{"line":378,"column":13,"offset":379},74,2767,{"type":34,"children":381,"position":391},[382],{"type":19,"value":383,"position":384},"While exposing each variable by hand works for basic cases, it can become tedious and messy when dealing with more, larger scripts. For this reason, it is recommended to expose either a class instance or a static class to avoid the repetition of individually exporting every method.",{"start":385,"end":388},{"line":386,"column":10,"offset":387},76,2769,{"line":386,"column":389,"offset":390},283,3051,{"start":392,"end":393},{"line":386,"column":10,"offset":387},{"line":386,"column":389,"offset":390},{"type":178,"lang":179,"meta":361,"value":395,"position":396},"import { saySquare } from 'utils/saysquare.js';\n\nclass MyPanelHandler {\n\tconstructor() {\n\t\t$.RegisterEventHandler('PanelLoaded', $.GetContextPanel(), () => this.onPanelLoaded());\n\t}\n\n\tonPanelLoaded() {\n\t\t$.Msg('Panel loaded!');\n\t}\n\n\tsaySquare(x) {\n\t\treturn saySquare(x);\n\t}\n\n\tsayHello() {\n\t\t$.Msg('Hello from MyPanelHandler!');\n\t}\n}\n\n// This name is arbitrary, but using\n// consistent names can help keep your code clean!\n$.GetContextObject()['MyPanelHandler'] = new MyPanelHandler();",{"start":397,"end":399},{"line":204,"column":10,"offset":398},3053,{"line":400,"column":13,"offset":401},102,3580,{"type":178,"lang":268,"meta":371,"value":403,"position":404},"\u003C!-- ... -->\n\t\u003CTextButton text=\"Square of 5\" onactivate=\"MyPanelHandler.saySquare(5)\" />\n\t\u003CTextButton text=\"Hello\" onactivate=\"MyPanelHandler.sayHello()\" />\n\u003C!-- ... -->",{"start":405,"end":408},{"line":406,"column":10,"offset":407},104,3582,{"line":409,"column":13,"offset":410},109,3795,{"type":16,"depth":134,"children":412,"position":422},[413],{"type":19,"value":414,"position":415},"Advanced Panel Interactivity",{"start":416,"end":419},{"line":417,"column":13,"offset":418},111,3800,{"line":417,"column":420,"offset":421},32,3828,{"start":423,"end":425},{"line":417,"column":10,"offset":424},3797,{"line":417,"column":420,"offset":421},{"type":34,"children":427,"position":450},[428,436,443],{"type":19,"value":429,"position":430},"For those who are Typescript-savvy, class decorators can also be used to automate this process, slimming down the required code for each panel even more. See Momentum Mod's ",{"start":431,"end":434},{"line":432,"column":10,"offset":433},113,3830,{"line":432,"column":355,"offset":435},4003,{"type":98,"value":437,"position":438},"module-helpers.ts",{"start":439,"end":440},{"line":432,"column":355,"offset":435},{"line":432,"column":441,"offset":442},193,4022,{"type":19,"value":444,"position":445}," for an implementation of this method.",{"start":446,"end":447},{"line":432,"column":441,"offset":442},{"line":432,"column":448,"offset":449},231,4060,{"start":451,"end":452},{"line":432,"column":10,"offset":433},{"line":432,"column":448,"offset":449},{"type":178,"lang":454,"meta":455,"value":456,"position":457},"ts",":: scripts/components/mypanel.ts","import { saySquare } from 'utils/saysquare.ts';\n\n@PanelHandler()\nclass MyPanelHan