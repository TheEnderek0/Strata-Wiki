"start":77,"end":78},{"line":69,"column":72,"offset":73},{"line":69,"column":79,"offset":80},202,423,{"type":20,"value":82,"position":83},".",{"start":84,"end":85},{"line":69,"column":79,"offset":80},{"line":69,"column":86,"offset":87},203,424,{"start":89,"end":90},{"line":69,"column":10,"offset":70},{"line":69,"column":86,"offset":87},{"type":17,"depth":10,"children":92,"position":101},[93],{"type":20,"value":94,"position":95},"Example Code",{"start":96,"end":98},{"line":27,"column":13,"offset":97},428,{"line":27,"column":99,"offset":100},15,440,{"start":102,"end":104},{"line":27,"column":10,"offset":103},426,{"line":27,"column":99,"offset":100},{"type":34,"children":106,"position":116},[107],{"type":20,"value":108,"position":109},"The following code shows how to define a snippet in a layout file:",{"start":110,"end":113},{"line":111,"column":10,"offset":112},13,442,{"line":111,"column":114,"offset":115},67,508,{"start":117,"end":118},{"line":111,"column":10,"offset":112},{"line":111,"column":114,"offset":115},{"type":120,"lang":121,"meta":122,"value":123,"position":124},"code","xml",":: layout/pages/mycoolpage.xml","\u003Croot>\n\n\t\u003Cstyles>\n\t\t\u003Cinclude src=\"file://{resources}/styles/main.scss\">\n\t\u003C/styles>\n\n\t\u003C!-- Include the script that will make use of the snippet -->\n\t\u003Cscripts>\n\t\t\u003Cinclude src=\"file://{scripts}/mypage.js\">\n\t\u003C/scripts>\n\n\t\u003C!-- Define the snippets for this panel -->\n\t\u003Csnippets>\n\t\t\u003Csnippet name=\"MyCoolSnippet\">\n\t\t\t\u003CPanel class=\"flow-down\">\n\t\t\t\t\u003C!-- We're using a dialog variable to display the name -->\n\t\t\t\t\u003CLabel text=\"Hello, {s:name}\"/>\n\t\t\t\t\u003CLabel text=\"Another line of {s:other_line}\"/>\n\t\t\t\u003C/Panel>\n\t\t\u003C/snippet>\n\t\u003C/snippets>\n\n\t\u003CPanel class=\"full flow-down\" id=\"MyRoot\">\n\t\t\u003C!-- The snippets will be added here by the code -->\n\t\u003C/Panel>\n\n\u003C/root>",{"start":125,"end":127},{"line":99,"column":10,"offset":126},510,{"line":128,"column":14,"offset":129},43,1193,{"type":34,"children":131,"position":141},[132],{"type":20,"value":133,"position":134},"The following script populates the above panel with children:",{"start":135,"end":138},{"line":136,"column":10,"offset":137},45,1195,{"line":136,"column":139,"offset":140},62,1256,{"start":142,"end":143},{"line":136,"column":10,"offset":137},{"line":136,"column":139,"offset":140},{"type":120,"lang":145,"meta":146,"value":147,"position":148},"js",":: scripts/mypage.js","// In this example, MyPage is simply acting as a namespace.\nclass MyPage {\n\tstatic {\n\t\t// Get the root panel\n\t\tconst root = $(\"#MyRoot\");\n\n\t\tconst names = ['Billy', 'Joe', 'Bob', 'Sean', 'Sussy'];\n\n\t\t// Create a few panels\n\t\tfor (let i = 0; i \u003C 5; ++i) {\n\t\t\t// Create a new panel with the root and a unique name\n\t\t\tconst panel = $.CreatePanel('Panel', root, 'myid_' + i);\n\n\t\t\t// Load the snippet on the panel\n\t\t\tpanel.LoadLayoutSnippet('MyCoolSnippet');\n\n\t\t\t// Now, we'll set the dialog vars\n\t\t\tpanel.SetDialogVariable('name', names[i]);\n\t\t\tpanel.SetDialogVariable('other_line', 'CHEESE');\n\t\t}\n\t}\n}",{"start":149,"end":152},{"line":150,"column":10,"offset":151},47,1258,{"line":153,"column":14,"offset":154},70,1887,{"start":156,"end":157},{"line":10,"column":10,"offset":11},{"line":158,"column":10,"offset":159},71,1888,{"title":21,"type":161},"markdown","panorama/overview"],"uses":{"params":["category","article"]}}]}
