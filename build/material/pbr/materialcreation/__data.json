":493,"end":495},{"line":72,"column":10,"offset":494},2904,{"line":72,"column":490,"offset":491},{"type":49,"children":497,"position":638},[498,506,519,525,538,545,560,567,583,590,607,614,631],{"type":20,"value":499,"position":500},"A ",{"start":501,"end":504},{"line":502,"column":10,"offset":503},27,2924,{"line":502,"column":13,"offset":505},2926,{"type":195,"children":507,"position":515},[508],{"type":20,"value":509,"position":510},"M",{"start":511,"end":513},{"line":502,"column":39,"offset":512},2928,{"line":502,"column":55,"offset":514},2929,{"start":516,"end":517},{"line":502,"column":13,"offset":505},{"line":502,"column":84,"offset":518},2931,{"type":20,"value":520,"position":521},"etalness, ",{"start":522,"end":523},{"line":502,"column":84,"offset":518},{"line":502,"column":209,"offset":524},2941,{"type":195,"children":526,"position":534},[527],{"type":20,"value":528,"position":529},"R",{"start":530,"end":532},{"line":502,"column":490,"offset":531},2943,{"line":502,"column":245,"offset":533},2944,{"start":535,"end":536},{"line":502,"column":209,"offset":524},{"line":502,"column":401,"offset":537},2946,{"type":20,"value":539,"position":540},"oughness, ",{"start":541,"end":542},{"line":502,"column":401,"offset":537},{"line":502,"column":543,"offset":544},33,2956,{"type":195,"children":546,"position":556},[547],{"type":20,"value":548,"position":549},"A",{"start":550,"end":553},{"line":502,"column":551,"offset":552},35,2958,{"line":502,"column":554,"offset":555},36,2959,{"start":557,"end":558},{"line":502,"column":543,"offset":544},{"line":502,"column":30,"offset":559},2961,{"type":20,"value":561,"position":562},"mbient ",{"start":563,"end":564},{"line":502,"column":30,"offset":559},{"line":502,"column":565,"offset":566},45,2968,{"type":195,"children":568,"position":578},[569],{"type":20,"value":570,"position":571},"O",{"start":572,"end":575},{"line":502,"column":573,"offset":574},47,2970,{"line":502,"column":576,"offset":577},48,2971,{"start":579,"end":580},{"line":502,"column":565,"offset":566},{"line":502,"column":581,"offset":582},50,2973,{"type":20,"value":584,"position":585},"cclusion map is a texture that contains the first 3 texture maps listed above in the RGB channels of the texture, respectively (Metalness on the Red channel, Roughness in the Green, AO in the Blue). This texture is used to compress the usually 3 needed maps down into one to free up drive space. While this might not seem like much space, this quickly adds up the more PBR materials your game/mod contains. While most programs do not contain a simple button that does this for you, there are very easy ways to create this texture with basic programs like ",{"start":586,"end":587},{"line":502,"column":581,"offset":582},{"line":502,"column":588,"offset":589},605,3528,{"type":90,"title":91,"url":591,"children":592,"position":602},"https://www.gimp.org/",[593],{"type":20,"value":594,"position":595},"GIMP",{"start":596,"end":599},{"line":502,"column":597,"offset":598},606,3529,{"line":502,"column":600,"offset":601},610,3533,{"start":603,"end":604},{"line":502,"column":588,"offset":589},{"line":502,"column":605,"offset":606},634,3557,{"type":20,"value":608,"position":609},", or with specialized programs like ",{"start":610,"end":611},{"line":502,"column":605,"offset":606},{"line":502,"column":612,"offset":613},670,3593,{"type":90,"title":91,"url":615,"children":616,"position":626},"https://koerismo.digital/projects#pbr-2-source",[617],{"type":20,"value":618,"position":619},"PBR-2-Source",{"start":620,"end":623},{"line":502,"column":621,"offset":622},671,3594,{"line":502,"column":624,"offset":625},683,3606,{"start":627,"end":628},{"line":502,"column":612,"offset":613},{"line":502,"column":629,"offset":630},732,3655,{"type":20,"value":632,"position":633},".",{"start":634,"end":635},{"line":502,"column":629,"offset":630},{"line":502,"column":636,"offset":637},733,3656,{"start":639,"end":640},{"line":502,"column":10,"offset":503},{"line":502,"column":641,"offset":642},734,3657,{"type":17,"depth":13,"children":644,"position":652},[645],{"type":20,"value":646,"position":647},"Method 1: GIMP",{"start":648,"end":650},{"line":411,"column":39,"offset":649},3662,{"line":411,"column":325,"offset":651},3676,{"start":653,"end":655},{"line":411,"column":10,"offset":654},3658,{"line":411,"column":325,"offset":651},{"type":49,"children":657,"position":666},[658],{"type":20,"value":659,"position":660},"GIMP can combine different layers into the RGBA channels of one texture, which makes creating MRAO maps using GIMP trivial.",{"start":661,"end":663},{"line":476,"column":10,"offset":662},3677,{"line":476,"column":664,"offset":665},124,3800,{"start":667,"end":668},{"line":476,"column":10,"offset":662},{"line":476,"column":463,"offset":669},3801,{"type":49,"children":671,"position":681},[672],{"type":20,"value":673,"position":674},"First, go to \"Image -> Mode\" and make sure \"Grayscale\" is selected. Even if your images are grayscale, GIMP may still treat them as color images, which prevents this method from working. Then, create a new image with the dimensions of your texture maps. Go to file and click \"Import as layers...\", select your Metalness, Roughness, and AO maps, and click Import. Your layers should now look similar to this (order is irrelevant):",{"start":675,"end":678},{"line":676,"column":10,"offset":677},31,3803,{"line":676,"column":679,"offset":680},430,4232,{"start":682,"end":683},{"line":676,"column":10,"offset":677},{"line":676,"column":679,"offset":680},{"type":49,"children":685,"position":696},[686],{"type":687,"title":91,"url":688,"alt":689,"position":690},"image","images/gimplayers.png","Metalness, Roughness, and AO maps in separate layers",{"start":691,"end":693},{"line":543,"column":10,"offset":692},4234,{"line":543,"column":694,"offset":695},79,4312,{"start":697,"end":698},{"line":543,"column":10,"offset":692},{"line":543,"column":694,"offset":695},{"type":49,"children":700,"position":709},[701],{"type":20,"value":702,"position":703},"After this, go to \"Colors -> Components -> Compose...\". Put your Metalness map in the Red channel, your Roughness map in the Green, and your AO map in the Blue. The dropdowns should look like this:",{"start":704,"end":706},{"line":551,"column":10,"offset":705},4314,{"line":551,"column":707,"offset":708},198,4511,{"start":710,"end":711},{"line":551,"column":10,"offset":705},{"line":551,"column":707,"offset":708},{"type":49,"children":713,"position":723},[714],{"type":687,"title":91,"url":715,"alt":716,"position":717},"images/gimpcompose.png","Metalness map in R, Roughness in G, AO in B",{"start":718,"end":720},{"line":15,"column":10,"offset":719},4513,{"line":15,"column":721,"offset":722},71,4583,{"start":724,"end":725},{"line":15,"column":10,"offset":719},{"line":15,"column":721,"offset":722},{"type":49,"children":727,"position":736},[728],{"type":20,"value":729,"position":730},"Now, click OK and let GIMP compose the image. After it finishes, you should get an image that looks similar to this:",{"start":731,"end":734},{"line":732,"column":10,"offset":733},39,4585,{"line":732,"column":354,"offset":735},4701,{"start":737,"end":738},{"line":732,"column":10,"offset":733},{"line":732,"column":354,"offset":735},{"type":49,"children":740,"position":751},[741],{"type":687,"title":91,"url":742,"alt":743,"position":744},"images/bwm004a_mrao.png","Mostly blue image",{"start":745,"end":748},{"line":746,"column":10,"offset":747},41,4703,{"line":746,"column":749,"offset":750},46,4748,{"start":752,"end":753},{"line":746,"column":10,"offset":747},{"line":746,"column":749,"offset":750},{"type":49,"children":755,"position":842},[756,787,795,812,819,835],{"type":192,"children":757,"position":781},[758,774],{"type":195,"children":759,"position":768},[760],{"type":20,"value":761,"position":762},"Note:",{"start":763,"end":766},{"line":764,"column":14,"offset":765},43,4753,{"line":764,"column":134,"offset":767},4758,{"start":769,"end":771},{"line":764,"column":33,"offset":770},4751,{"line":764,"column":772,"offset":773},11,4760,{"type":20,"value":775,"position":776}," Your image could have a different balance of colors depending on the intensity of each map",{"start":777,"end":778},{"line":764,"column":772,"offset":773},{"line":764,"column":779,"offset":780},102,4851,{"start":782,"end":784},{"line":764,"column":10,"offset":783},4750,{"line":764,"column":785,"offset":786},103,4852,{"type":20,"value":788,"position":789},"\nThe final step of making an MRAO texture is converting it to a VTF. This can be done with ",{"start":790,"end":791},{"line":764,"column":785,"offset":786},{"line":792,"column":793,"offset":794},44,91,4943,{"type":90,"title":91,"url":796,"children":797,"position":807},"https://valvedev.info/tools/vtfedit/",[798],{"type":20,"value":799,"position":800},"VTFEdit",{"start":801,"end":804},{"line":792,"column":802,"offset":803},92,4944,{"line":792,"column":805,"offset":806},99,4951,{"start":808,"end":809},{"line":792,"column":793,"offset":794},{"line":792,"column":810,"offset":811},138,4990,{"type":20,"value":813,"position":814},", or our ",{"start":815,"end":816},{"line":792,"column":810,"offset":811},{"line":792,"column":817,"offset":818},147,4999,{"type":90,"title":91,"url":820,"children":821,"position":830},"/modding/util/vtex2",[822],{"type":20,"value":823,"position":824},"VTex2",{"start":825,"end":827},{"line":792,"column":251,"offset":826},5000,{"line":792,"column":828,"offset":829},153,5005,{"start":831,"end":832},{"line":792,"column":817,"offset":818},{"line":792,"column":833,"offset":834},175,5027,{"type":20,"value":836,"position":837}," tool, which supports Strata's new VTF 7.6 version.",{"start":838,"end":839},{"line":792,"column":833,"offset":834},{"line":792,"column":840,"offset":841},226,5078,{"start":843,"end":844},{"line":764,"column":10,"offset":783},{"line":792,"column":845,"offset":846},227,5079,{"type":17,"depth":14,"children":848,"position":856},[849],{"type":20,"value":850,"position":851},"Manual VMT creation",{"start":852,"end":854},{"line":565,"column":55,"offset":853},5085,{"line":565,"column":26,"offset":855},5104,{"start":857,"end":859},{"line":565,"column":10,"offset":858},5080,{"line":565,"column":26,"offset":855},{"type":49,"children":861,"position":882},[862,869,875],{"type":20,"value":863,"position":864},"Create a new ",{"start":865,"end":867},{"line":749,"column":10,"offset":866},5105,{"line":749,"column":242,"offset":868},5118,{"type":451,"value":870,"position":871},".VMT",{"start":872,"end":873},{"line":749,"column":242,"offset":868},{"line":749,"column":490,"offset":874},5124,{"type":20,"value":876,"position":877}," file and paste this text in:",{"start":878,"end":879},{"line":749,"column":490,"offset":874},{"line":749,"column":880,"offset":881},49,5153,{"start":883,"end":884},{"line":749,"column":10,"offset":866},{"line":749,"column":880,"offset":881},{"type":886,"lang":91,"meta":91,"value":887,"position":888},"code","\"PBR\"\n{\n    $basetexture               \"\u003Cinsert path to diffuse texture>\"\n    $bumpmap                   \"\u003Cinsert path to normal map>\"\n    $mraotexture               \"\u003Cinsert path to MRAO map>\"\n\n    $envmap                    \"env_cubemap\"\n}",{"start":889,"end":891},{"line":573,"column":10,"offset":890},5154,{"line":892,"column":14,"offset":893},56,5403,{"type":49,"children":895,"position":904},[896],{"type":20,"value":897,"position":898},"Insert the paths to the correct materials where specified, and you are done!",{"start":899,"end":901},{"line":301,"column":10,"offset":900},5404,{"line":301,"column":902,"offset":903},77,5480,{"start":905,"end":906},{"line":301,"column":10,"offset":900},{"line":301,"column":902,"offset":903},{"type":17,"depth":13,"children":908,"position":917},[909],{"type":20,"value":910,"position":911},"Method 2: PBR-2-Source",{"start":912,"end":915},{"line":913,"column":39,"offset":914},58,5485,{"line":913,"column":502,"offset":916},5507,{"start":918,"end":920},{"line":913,"column":10,"offset":919},5481,{"line":913,"column":502,"offset":916},{"type":49,"children":922,"position":946},[923,931,939],{"type":20,"value":924,"position":925},"Launch PBR-2-Source and wait for the GUI to appear. Insert your images into the correct boxes and double check that the \"Shader\" option is set to \"PBR (",{"start":926,"end":929},{"line":927,"column":10,"offset":928},59,5508,{"line":927,"column":828,"offset":930},5660,{"type":932,"value":933,"position":934},"html","\u003Cintended use>",{"start":935,"end":936},{"line":927,"column":828,"offset":930},{"line":927,"column":937,"offset":938},167,5674,{"type":20,"value":940,"position":941},")\". Next, make sure the \"Flip Normal Y\" check is set correctly. If the program you used uses 3DS Max style normal maps, or you generated it from VTFEdit or pulled from an existing Source game, toggle the option off. If the program used to generate the map uses Maya-style normal maps, toggle the option on. If you are unsure what style of normal map your program uses, make sure to find out before going further, or the generated normal map could look, for lack of a better word, \"ugly\". After you do this, click export, select the folder and the output file name, then wait for PBR-2-Source to do the work for you. It will generate a fully functional PBR material.",{"start":942,"end":943},{"line":927,"column":937,"offset":938},{"line":927,"column":944,"offset":945},832,6339,{"start":947,"end":948},{"line":927,"column":10,"offset":928},{"line":927,"column":944,"offset":945},{"type":17,"depth":33,"children":950,"position":959},[951],{"type":20,"value":952,"position":953},"Finalizing",{"start":954,"end":957},{"line":955,"column":14,"offset":956},61,6344,{"line":955,"column":242,"offset":958},6354,{"start":960,"end":962},{"line":955,"column":10,"offset":961},6341,{"line":955,"column":242,"offset":958},{"type":49,"children":964,"position":995},[965,972,988],{"type":20,"value":966,"position":967},"All that is needed now is the editing and testing of your material. If your PBR material includes a Heightmap in the Alpha channel of your Bumpmap, see ",{"start":968,"end":970},{"line":27,"column":10,"offset":969},6355,{"line":27,"column":828,"offset":971},6507,{"type":90,"title":91,"url":364,"children":973,"position":983},[974],{"type":20,"value":975,"position":976},"This page",{"start":977,"end":980},{"line":27,"column":978,"offset":979},154,6508,{"line":27,"column":981,"offset":982},163,6517,{"start":984,"end":985},{"line":27,"column":828,"offset":971},{"line":27,"column":986,"offset":987},195,6549,{"type":20,"value":989,"position":990}," on how to make it functional. Make any adjustments you want to your VMT, and you are done!",{"start":991,"end":992},{"line":27,"column":986,"offset":987},{"line":27,"column":993,"offset":994},286,6640,{"start":996,"end":997},{"line":27,"column":10,"offset":969},{"line":27,"column":993,"offset":994},{"start":999,"end":1000},{"line":10,"column":10,"offset":11},{"line":46,"column":10,"offset":1001},6641,{"title":21,"type":1003},"markdown","material/pbr"],"uses":{"params":["category","article"]}}]}
