8},{"line":207,"column":13,"offset":208},{"line":207,"column":144,"offset":225},{"start":230,"end":232},{"line":207,"column":10,"offset":231},726,{"line":207,"column":144,"offset":225},{"type":123,"spread":1,"checked":53,"children":234,"position":256},[235],{"type":49,"children":236,"position":253},[237],{"type":52,"title":53,"url":238,"children":239,"position":248},"https://www.gimp.org/",[240],{"type":20,"value":241,"position":242},"GIMP",{"start":243,"end":246},{"line":244,"column":14,"offset":245},11,797,{"line":244,"column":131,"offset":247},801,{"start":249,"end":251},{"line":244,"column":13,"offset":250},796,{"line":244,"column":30,"offset":252},825,{"start":254,"end":255},{"line":244,"column":13,"offset":250},{"line":244,"column":30,"offset":252},{"start":257,"end":259},{"line":244,"column":10,"offset":258},794,{"line":244,"column":30,"offset":252},{"start":261,"end":262},{"line":131,"column":10,"offset":163},{"line":244,"column":30,"offset":252},{"type":17,"depth":33,"children":264,"position":273},[265],{"type":20,"value":266,"position":267},"Embedding the Heightmap",{"start":268,"end":270},{"line":42,"column":14,"offset":269},829,{"line":42,"column":271,"offset":272},27,852,{"start":274,"end":276},{"line":42,"column":10,"offset":275},826,{"line":42,"column":271,"offset":272},{"type":49,"children":278,"position":287},[279],{"type":20,"value":280,"position":281},"Open both your Heightmap and Bumpmap separately in GIMP. Copy your Heightmap, then navigate to the layers window of your bumpmap and click on the Layer Mask button.",{"start":282,"end":284},{"line":186,"column":10,"offset":283},853,{"line":186,"column":285,"offset":286},165,1017,{"start":288,"end":289},{"line":186,"column":10,"offset":283},{"line":186,"column":285,"offset":286},{"type":49,"children":291,"position":301},[292],{"type":293,"title":53,"url":294,"alt":295,"position":296},"image","images/Layermaskbutton.png","Click on the hand holding a mask",{"start":297,"end":299},{"line":220,"column":10,"offset":298},1019,{"line":220,"column":60,"offset":300},1082,{"start":302,"end":303},{"line":220,"column":10,"offset":298},{"line":220,"column":60,"offset":300},{"type":49,"children":305,"position":315},[306],{"type":20,"value":307,"position":308},"A small window asking about what to fill the mask with should pop up. Select White, then click ok. Now, paste your Heightmap into the layer mask. Your layer should now look like this:",{"start":309,"end":312},{"line":310,"column":10,"offset":311},17,1084,{"line":310,"column":313,"offset":314},184,1267,{"start":316,"end":317},{"line":310,"column":10,"offset":311},{"line":310,"column":313,"offset":314},{"type":49,"children":319,"position":329},[320],{"type":293,"title":53,"url":321,"alt":322,"position":323},"images/Layersfinal.png","The Heightmap is in a separate box next to the bumpmap",{"start":324,"end":326},{"line":26,"column":10,"offset":325},1270,{"line":26,"column":327,"offset":328},82,1351,{"start":330,"end":331},{"line":26,"column":10,"offset":325},{"line":26,"column":327,"offset":328},{"type":49,"children":333,"position":343},[334],{"type":20,"value":335,"position":336},"The main image should now appear transparent, as GIMP always interprets alpha masks as transparency masks. This can be ignored, as the engine will interpret this correctly. Now, export your image and convert it to a VTF.",{"start":337,"end":340},{"line":338,"column":10,"offset":339},21,1353,{"line":338,"column":341,"offset":342},221,1573,{"start":344,"end":345},{"line":338,"column":10,"offset":339},{"line":338,"column":346,"offset":347},222,1574,{"type":17,"depth":33,"children":349,"position":358},[350],{"type":20,"value":351,"position":352},"Adjusting the VMT",{"start":353,"end":356},{"line":354,"column":14,"offset":355},22,1578,{"line":354,"column":338,"offset":357},1595,{"start":359,"end":361},{"line":354,"column":10,"offset":360},1575,{"line":354,"column":338,"offset":357},{"type":49,"children":363,"position":386},[364,372,379],{"type":20,"value":365,"position":366},"Change the ",{"start":367,"end":370},{"line":368,"column":10,"offset":369},23,1596,{"line":368,"column":42,"offset":371},1607,{"type":373,"value":374,"position":375},"inlineCode","$bumpmap",{"start":376,"end":377},{"line":368,"column":42,"offset":371},{"line":368,"column":354,"offset":378},1617,{"type":20,"value":380,"position":381}," parameter in your VMT to the new Bumpmap, then put the following into your VMT:",{"start":382,"end":383},{"line":368,"column":354,"offset":378},{"line":368,"column":384,"offset":385},102,1697,{"start":387,"end":388},{"line":368,"column":10,"offset":369},{"line":368,"column":384,"offset":385},{"type":390,"lang":53,"meta":53,"value":391,"position":392},"code","   $parallax \"1\"\n   $parallaxcenter \"0.5\"\n   $parallaxdepth \"0.1\"",{"start":393,"end":396},{"line":394,"column":10,"offset":395},24,1698,{"line":397,"column":14,"offset":398},28,1771,{"type":49,"children":400,"position":415},[401,409],{"type":373,"value":402,"position":403},"$parallaxcenter",{"start":404,"end":407},{"line":405,"column":10,"offset":406},29,1772,{"line":405,"column":62,"offset":408},1789,{"type":20,"value":410,"position":411}," essentially defines the distance of the highest point of the material from the plane it is applied to, or how far away the highest point is, on a scale from 0-1; the higher the number the closer to the plane it is. It is recommended adjust this parameter with Hammer open, as materials reload instantly and you can move your camera around freely.",{"start":412,"end":413},{"line":405,"column":62,"offset":408},{"line":405,"column":84,"offset":414},2136,{"start":416,"end":417},{"line":405,"column":10,"offset":406},{"line":405,"column":418,"offset":419},366,2137,{"type":49,"children":421,"position":436},[422,429],{"type":373,"value":423,"position":424},"$parallaxdepth",{"start":425,"end":427},{"line":15,"column":10,"offset":426},2139,{"line":15,"column":310,"offset":428},2155,{"type":20,"value":430,"position":431}," defines the intensity of the effect, on a scale of 0-1; the higher the number the greater the intensity. \"0.1\" is a good starting point, but you may need to increase/decrease it to get the desired effect. Values to the hundredths place are accepted.",{"start":432,"end":433},{"line":15,"column":310,"offset":428},{"line":15,"column":434,"offset":435},267,2405,{"start":437,"end":438},{"line":15,"column":10,"offset":426},{"line":15,"column":434,"offset":435},{"start":440,"end":441},{"line":10,"column":10,"offset":11},{"line":30,"column":10,"offset":442},2406,{"title":21,"type":444},"markdown","material/pbr"],"uses":{"params":["category","article"]}}]}
