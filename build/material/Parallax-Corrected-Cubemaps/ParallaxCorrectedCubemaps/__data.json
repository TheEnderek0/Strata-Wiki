t":507},2217,{"type":33,"children":509,"position":519},[510],{"type":20,"value":511,"position":512},"Here is the process of creating the necessary entities in Hammer for this feature to work in a room you’ve already made.",{"start":513,"end":516},{"line":514,"column":10,"offset":515},47,2218,{"line":514,"column":517,"offset":518},121,2338,{"start":520,"end":521},{"line":514,"column":10,"offset":515},{"line":514,"column":517,"offset":518},{"type":33,"children":523,"position":538},[524,532],{"type":20,"value":525,"position":526},"The first thing you should do is to create the “bounding box” of the cubemap with a trigger brush. Make it so that it fits the room as closely as possible.\n",{"start":527,"end":530},{"line":528,"column":10,"offset":529},49,2340,{"line":159,"column":10,"offset":531},2496,{"type":36,"title":37,"url":533,"alt":39,"position":534},"images/cube_2.jpg",{"start":535,"end":536},{"line":159,"column":10,"offset":531},{"line":159,"column":362,"offset":537},2550,{"start":539,"end":540},{"line":528,"column":10,"offset":529},{"line":159,"column":362,"offset":537},{"type":33,"children":542,"position":552},[543],{"type":20,"value":544,"position":545},"Once you’ve made the trigger brush, tie it to a parallax_obb entity and give it a name:",{"start":546,"end":549},{"line":547,"column":10,"offset":548},52,2552,{"line":547,"column":550,"offset":551},88,2639,{"start":553,"end":554},{"line":547,"column":10,"offset":548},{"line":547,"column":550,"offset":551},{"type":33,"children":556,"position":565},[557],{"type":36,"title":37,"url":558,"alt":39,"position":559},"images/cube_3.png",{"start":560,"end":563},{"line":561,"column":10,"offset":562},54,2641,{"line":561,"column":362,"offset":564},2695,{"start":566,"end":567},{"line":561,"column":10,"offset":562},{"line":561,"column":362,"offset":564},{"type":33,"children":569,"position":579},[570],{"type":20,"value":571,"position":572},"That’s all that is needed for the brush, onto the cubemap entity itself.",{"start":573,"end":576},{"line":574,"column":10,"offset":575},56,2697,{"line":574,"column":577,"offset":578},73,2769,{"start":580,"end":581},{"line":574,"column":10,"offset":575},{"line":574,"column":577,"offset":578},{"type":33,"children":583,"position":593},[584],{"type":20,"value":585,"position":586},"When creating an env_cubemap you should see an extra option called “Cubemap Bounds”. Set it to the name of the parallax_obb you just created.",{"start":587,"end":590},{"line":588,"column":10,"offset":589},58,2771,{"line":588,"column":591,"offset":592},142,2912,{"start":594,"end":595},{"line":588,"column":10,"offset":589},{"line":588,"column":591,"offset":592},{"type":33,"children":597,"position":606},[598],{"type":36,"title":37,"url":599,"alt":39,"position":600},"images/cube_1.png",{"start":601,"end":604},{"line":602,"column":10,"offset":603},60,2914,{"line":602,"column":362,"offset":605},2968,{"start":607,"end":608},{"line":602,"column":10,"offset":603},{"line":602,"column":362,"offset":605},{"type":33,"children":610,"position":620},[611],{"type":20,"value":612,"position":613},"This should be all the setup that is required in Hammer.",{"start":614,"end":617},{"line":615,"column":10,"offset":616},62,2970,{"line":615,"column":618,"offset":619},57,3026,{"start":621,"end":622},{"line":615,"column":10,"offset":616},{"line":615,"column":618,"offset":619},{"type":33,"children":624,"position":632},[625],{"type":20,"value":626,"position":627},"You should be able to compile your map as normal and build the cubemaps in game to see the effects if you have any supported materials in the map.",{"start":628,"end":630},{"line":322,"column":10,"offset":629},3028,{"line":322,"column":56,"offset":631},3174,{"start":633,"end":634},{"line":322,"column":10,"offset":629},{"line":322,"column":56,"offset":631},{"start":636,"end":637},{"line":10,"column":10,"offset":11},{"line":638,"column":10,"offset":639},67,3177,{"title":21,"type":641},"markdown","material/Parallax-Corrected-Cubemaps"],"uses":{"params":["category","article"]}}]}
