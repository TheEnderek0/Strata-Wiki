se,{"type":3,"children":4,"position":1426},"root",[5,16,34,49,162,176,198,213,227,291,307,322,337,351,365,379,443,456,809,822,836,849,911,924,937,950,963,1006,1020,1033,1047,1086,1134,1147,1190,1204,1218,1230,1293,1307,1321,1335,1356,1370,1384],{"type":6,"value":7,"position":8},"yaml","title: \"Clustered Lighting: How Does It Work?\"\nfeatures:\n    - USE_CLUSTERED",{"start":9,"end":12},{"line":10,"column":10,"offset":11},1,0,{"line":13,"column":14,"offset":15},5,4,84,{"type":17,"depth":10,"children":18,"position":30},"heading",[19],{"type":20,"value":21,"position":22},"text","Clustered Lighting: How Does It Work?",{"start":23,"end":27},{"line":24,"column":25,"offset":26},6,3,87,{"line":24,"column":28,"offset":29},40,124,{"start":31,"end":33},{"line":24,"column":10,"offset":32},85,{"line":24,"column":28,"offset":29},{"type":35,"children":36,"position":46},"paragraph",[37],{"type":20,"value":38,"position":39},"Clustered Lighting adds a new dynamic lighting system to Strata, with the following major improvements:",{"start":40,"end":43},{"line":41,"column":10,"offset":42},8,126,{"line":41,"column":44,"offset":45},104,229,{"start":47,"end":48},{"line":41,"column":10,"offset":42},{"line":41,"column":44,"offset":45},{"type":50,"ordered":1,"start":51,"spread":1,"children":52,"position":159},"list",null,[53,74,139],{"type":54,"spread":1,"checked":51,"children":55,"position":70},"listItem",[56],{"type":35,"children":57,"position":67},[58],{"type":20,"value":59,"position":60},"Specular lighting now works on all surfaces, brush or prop, indoors or outdoors.",{"start":61,"end":64},{"line":62,"column":25,"offset":63},10,233,{"line":62,"column":65,"offset":66},83,313,{"start":68,"end":69},{"line":62,"column":25,"offset":63},{"line":62,"column":65,"offset":66},{"start":71,"end":73},{"line":62,"column":10,"offset":72},231,{"line":62,"column":65,"offset":66},{"type":54,"spread":1,"checked":51,"children":75,"position":135},[76,90],{"type":35,"children":77,"position":87},[78],{"type":20,"value":79,"position":80},"light_rt entities can now cast light and shadows dynamically.",{"start":81,"end":84},{"line":82,"column":25,"offset":83},11,316,{"line":82,"column":85,"offset":86},64,377,{"start":88,"end":89},{"line":82,"column":25,"offset":83},{"line":82,"column":85,"offset":86},{"type":50,"ordered":1,"start":51,"spread":1,"children":91,"position":132},[92,112],{"type":54,"spread":1,"checked":51,"children":93,"position":108},[94],{"type":35,"children":95,"position":105},[96],{"type":20,"value":97,"position":98},"Lights can move and their light and shadows will move with them.",{"start":99,"end":102},{"line":100,"column":13,"offset":101},12,382,{"line":100,"column":103,"offset":104},69,446,{"start":106,"end":107},{"line":100,"column":13,"offset":101},{"line":100,"column":103,"offset":104},{"start":109,"end":111},{"line":100,"column":25,"offset":110},380,{"line":100,"column":103,"offset":104},{"type":54,"spread":1,"checked":51,"children":113,"position":128},[114],{"type":35,"children":115,"position":125},[116],{"type":20,"value":117,"position":118},"Entities can move under lights and have their lighting updated. This includes brush entities.",{"start":119,"end":122},{"line":120,"column":13,"offset":121},13,451,{"line":120,"column":123,"offset":124},98,544,{"start":126,"end":127},{"line":120,"column":13,"offset":121},{"line":120,"column":123,"offset":124},{"start":129,"end":131},{"line":120,"column":25,"offset":130},449,{"line":120,"column":123,"offset":124},{"start":133,"end":134},{"line":100,"column":25,"offset":110},{"line":120,"column":123,"offset":124},{"start":136,"end":138},{"line":82,"column":10,"offset":137},314,{"line":120,"column":123,"offset":124},{"type":54,"spread":1,"checked":51,"children":140,"position":155},[141],{"type":35,"children":142,"position":152},[143],{"type":20,"value":144,"position":145},"Hammer can now preview lighting and shadows in real time.",{"start":146,"end":149},{"line":147,"column":25,"offset":148},14,547,{"line":147,"column":150,"offset":151},60,604,{"start":153,"end":154},{"line":147,"column":25,"offset":148},{"line":147,"column":150,"offset":151},{"start":156,"end":158},{"line":147,"column":10,"offset":157},545,{"line":147,"column":150,"offset":151},{"start":160,"end":161},{"line":62,"column":10,"offset":72},{"line":147,"column":150,"offset":151},{"type":35,"children":163,"position":173},[164],{"type":20,"value":165,"position":166},"Currently, only Portal 2: Community Edition and Momentum Mod support Clustered Lighting. There are currently no plans to add Clustered Lighting to Portal: Revolution.",{"start":167,"end":170},{"line":168,"column":10,"offset":169},16,606,{"line":168,"column":171,"offset":172},167,772,{"start":174,"end":175},{"line":168,"column":10,"offset":169},{"line":168,"column":171,"offset":172},{"type":177,"children":178,"position":194},"blockquote",[179],{"type":35,"children":180,"position":191},[181],{"type":20,"value":182,"position":183},"[!NOTE]\nClustered currently works for the PBR, LMG, VLG, Water, Paint, Gel Blobs, and Eyes shaders",{"start":184,"end":187},{"line":185,"column":25,"offset":186},18,776,{"line":188,"column":189,"offset":190},19,93,876,{"start":192,"end":193},{"line":185,"column":25,"offset":186},{"line":188,"column":189,"offset":190},{"start":195,"end":197},{"line":185,"column":10,"offset":196},774,{"line":188,"column":189,"offset":190},{"type":17,"depth":199,"children":200,"position":209},2,[201],{"type":20,"value":202,"position":203},"How Does it Work?",{"start":204,"end":207},{"line":205,"column":14,"offset":206},21,881,{"line":205,"column":205,"offset":208},898,{"start":210,"end":212},{"line":205,"column":10,"offset":211},878,{"line":205,"column":205,"offset":208},{"type":35,"children":214,"position":224},[215],{"type":20,"value":216,"position":217},"Traditionally in Source, light sources light up the map in two ways: by directly shining light onto a surface, and indirectly, by having their light bounce onto other surfaces. Both direct and indirect lighting are calculated by VRAD when the map is compiled, and \"baked\" into the map's lightmap, which can generally be thought of as an unmoving texture that is painted onto all the \"lit\" surfaces of the map.",{"start":218,"end":221},{"line":219,"column":10,"offset":220},23,900,{"line":219,"column":222,"offset":223},410,1309,{"start":225,"end":226},{"line":219,"column":10,"offset":220},{"line":219,"column":222,"offset":223},{"type":50,"ordered":1,"start":51,"spread":1,"children":228,"position":288},[229,249,269],{"type":54,"spread":1,"checked":51,"children":230,"position":245},[231],{"type":35,"children":232,"position":242},[233],{"type":20,"value":234,"position":235},"Top: Normal lighting.",{"start":236,"end":239},{"line":237,"column":25,"offset":238},25,1313,{"line":237,"column":240,"offset":241},24,1334,{"start":243,"end":244},{"line":237,"column":25,"offset":238},{"line":237,"column":240,"offset":241},{"start":246,"end":248},{"line":237,"column":10,"offset":247},1311,{"line":237,"column":240,"offset":241},{"type":54,"spread":1,"checked":51,"children":250,"position":265},[251],{"type":35,"children":252,"position":262},[253],{"type":20,"value":254,"position":255},"Middle: Direct lighting only. Notice how the backs of the cubes are now completely black, since no light is directly hitting them.",{"start":256,"end":259},{"line":257,"column":25,"offset":258},26,1337,{"line":257,"column":260,"offset":261},133,1467,{"start":263,"end":264},{"line":257,"column":25,"offset":258},{"line":257,"column":260,"offset":261},{"start":266,"end":268},{"line":257,"column":10,"offset":267},1335,{"line":257,"column":260,"offset":261},{"type":54,"spread":1,"checked":51,"children":270,"position":284},[271],{"type":35,"children":272,"position":281},[273],{"type":20,"value":274,"position":275},"Bottom: Indirect lighting only. The room is now only dimly lit by the reflected light, but the bright direct light is gone.",{"start":276,"end":279},{"line":277,"column":25,"offset":278},27,1470,{"line":277,"column":42,"offset":280},1593,{"start":282,"end":283},{"line":277,"column":25,"offset":278},{"line":277,"column":42,"offset":280},{"start":285,"end":287},{"line":277,"column":10,"offset":286},1468,{"line":277,"column":42,"offset":280},{"start":289,"end":290},{"line":237,"column":10,"offset":247},{"line":277,"column":42,"offset":280},{"type":35,"children":292,"position":304},[293],{"type":294,"title":51,"url":295,"alt":296,"position":297},"image","images\\only_direct1.jpg","Normal Lighting",{"start":298,"end":301},{"line":299,"column":10,"offset":300},29,1595,{"line":299,"column":302,"offset":303},44,1638,{"start":305,"end":306},{"line":299,"column":10,"offset":300},{"line":299,"column":302,"offset":303},{"type":35,"children":308,"position":319},[309],{"type":294,"title":51,"url":310,"alt":311,"position":312},"images\\only_direct2.jpg","Direct lighting only",{"start":313,"end":316},{"line":314,"column":10,"offset":315},31,1640,{"line":314,"column":317,"offset":318},49,1688,{"start":320,"end":321},{"line":314,"column":10,"offset":315},{"line":314,"column":317,"offset":318},{"type":35,"children":323,"position":334},[324],{"type":294,"title":51,"url":325,"alt":326,"position":327},"images\\only_indirect.jpg","Indirect lighting only",{"start":328,"end":331},{"line":329,"column":10,"offset":330},33,1690,{"line":329,"column":332,"offset":333},52,1741,{"start":335,"end":336},{"line":329,"column":10,"offset":330},{"line":329,"column":332,"offset":333},{"type":35,"children":338,"position":348},[339],{"type":20,"value":340,"position":341},"Two major limitations of this system are that it cannot easily support dynamic light and shadows, since both are baked into the lightmap which can only change in very limited ways at runtime, and that it does not support specular lighting.",{"start":342,"end":345},{"line":343,"column":10,"offset":344},35,1743,{"line":343,"column":346,"offset":347},240,1982,{"start":349,"end":350},{"line":343,"column":10,"offset":344},{"line":343,"column":346,"offset":347},{"type":35,"children":352,"position":362},[353],{"type":20,"value":354,"position":355},"Specular lighting is the light that's reflected off of smooth, shiny surfaces, usually forming a bright highlight. Specular lighting is unique in that it can change drastically depending on the player's view position relative to the surface and the light, so it can't easily be recorded into the lightmap. This is not true for direct and indirect lighting, as these are diffuse types of lighting, which means they don't depend on the player's view position.",{"start":356,"end":359},{"line":357,"column":10,"offset":358},37,1984,{"line":357,"column":360,"offset":361},458,2441,{"start":363,"end":364},{"line":357,"column":10,"offset":358},{"line":357,"column":360,"offset":361},{"type":35,"children":366,"position":376},[367],{"type":20,"value":368,"position":369},"Clustered lighting improves these limitations by adding dynamic lighting that is calculated at runtime, and not exclusively baked into the lightmap. Now, we can change the following three properties:",{"start":370,"end":373},{"line":371,"column":10,"offset":372},39,2443,{"line":371,"column":374,"offset":375},200,2642,{"start":377,"end":378},{"line":371,"column":10,"offset":372},{"line":371,"column":374,"offset":375},{"type":50,"ordered":1,"start":51,"spread":1,"children":380,"position":440},[381,400,420],{"type":54,"spread":1,"checked":51,"children":382,"position":396},[383],{"type":35,"children":384,"position":393},[385],{"type":20,"value":386,"position":387},"Direct lighting can be statically baked into the lightmap or dynamic",{"start":388,"end":390},{"line":28,"column":25,"offset":389},2645,{"line":28,"column":391,"offset":392},71,2713,{"start":394,"end":395},{"line":28,"column":25,"offset":389},{"line":28,"column":391,"offset":392},{"start":397,"end":399},{"line":28,"column":10,"offset":398},2643,{"line":28,"column":391,"offset":392},{"type":54,"spread":1,"checked":51,"children":401,"position":416},[402],{"type":35,"children":403,"position":413},[404],{"type":20,"value":405,"position":406},"Indirect lighting can be statically baked into the lightmap or disabled",{"start":407,"end":410},{"line":408,"column":25,"offset":409},41,2716,{"line":408,"column":411,"offset":412},74,2787,{"start":414,"end":415},{"line":408,"column":25,"offset":409},{"line":408,"column":411,"offset":412},{"start":417,"end":419},{"line":408,"column":10,"offset":418},2714,{"line":408,"column":411,"offset":412},{"type":54,"spread":1,"checked":51,"children":421,"position":436},[422],{"type":35,"children":423,"position":433},[424],{"type":20,"value":425,"position":426},"Specular lighting can be disabled or dynamic",{"start":427,"end":430},{"line":428,"column":25,"offset":429},42,2790,{"line":428,"column":431,"offset":432},47,2834,{"start":434,"end":435},{"line":428,"column":25,"offset":429},{"line":428,"column":431,"offset":432},{"start":437,"end":439},{"line":428,"column":10,"offset":438},2788,{"line":428,"column":431,"offset":432},{"start":441,"end":442},{"line":28,"column":10,"offset":398},{"line":428,"column":431,"offset":432},{"type":35,"children":444,"position":453},[445],{"type":20,"value":446,"position":447},"Which technique is used is controlled by the light's \"Light mode\":",{"start":448,"end":450},{"line":302,"column":10,"offset":449},2836,{"line":302,"column":451,"offset":452},67,2902,{"start":454,"end":455},{"line":302,"column":10,"offset":449},{"line":302,"column":451,"offset":452},{"type":457,"align":458,"children":459,"position":806},"table",[51,51,51,51],[460,517,587,652,727],{"type":461,"children":462,"position":514},"tableRow",[463,472,485,499],{"type":464,"children":465,"position":466},"tableCell",[],{"start":467,"end":470},{"line":468,"column":10,"offset":469},46,2904,{"line":468,"column":188,"offset":471},2922,{"type":464,"children":473,"position":481},[474],{"type":20,"value":475,"position":476},"Direct",{"start":477,"end":479},{"line":468,"column":205,